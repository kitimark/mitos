import Lean
import MitosGate.Util

/-!
# `statements.lock`

Declarations Lean generates (`match_*`, `_f`, `decEq`, `casesOn`, …) are not listed, but a
listed declaration can keep its meaning in them: a structurally recursive definition's value is
`List.brecOn … f._f`, and a `match`'s patterns live in its `match_1`. So each line also hashes, in
`aux=`, every unlisted core declaration its type or value reaches, transitively, hashed the same
way.

(`Expr.hash` is not used: its effective width is 32 bits.)
-/

open Lean

namespace MitosGate.Lock

def header : String :=
  "# statements.lock: generated by `lake exe mitos-gate lock`. Do not edit by hand.\n" ++
  "# A change to this file needs the `spec-approved` label (see docs/process.md).\n"

private def splitOnChar (sep : Char) : List Char → List (List Char)
  | [] => [[]]
  | c :: cs =>
    let rest := splitOnChar sep cs
    if c == sep then [] :: rest
    else match rest with
      | [] => [[c]]
      | line :: lines => (c :: line) :: lines

def firstTwoLinesMatchHeader (txt : String) : Bool :=
  match splitOnChar '\n' header.toList with
  | [l1, l2, []] =>
    match splitOnChar '\n' txt.toList with
    | l1' :: l2' :: _ => !l1.isEmpty && !l2.isEmpty && l1 == l1' && l2 == l2'
    | _ => false
  | _ => false

private def joinLines : List (List Char) → List Char
  | [] => []
  | [line] => line
  | line :: rest => line ++ '\n' :: joinLines rest

private def otherLine : List Char := ['o', 't', 'h', 'e', 'r']

-- `decide` on `String.toList`, and unfolding `splitOnChar` over the whole header, is what
-- made `lake build` slow. Each piece below is short enough for one cheap `decide`.
private def p1a : String := "# statements.lock: g"
private def p1b : String := "enerated by `lake ex"
private def p1c : String := "e mitos-gate lock`. "
private def p1d : String := "Do not edit by hand."
private def p2a : String := "# A change to this f"
private def p2b : String := "ile needs the `spec-"
private def p2c : String := "approved` label (see"
private def p2d : String := " docs/process.md)."
private def line1 : String := p1a ++ p1b ++ p1c ++ p1d
private def line2 : String := p2a ++ p2b ++ p2c ++ p2d

private theorem splitOnChar_append_sep {sep : Char} {l rest : List Char}
    (h : ∀ c ∈ l, c ≠ sep) : splitOnChar sep (l ++ sep :: rest) = l :: splitOnChar sep rest := by
  induction l with
  | nil => simp [splitOnChar]
  | cons c cs ih =>
    have hc : c ≠ sep := h c (by simp)
    have hbeq : (c == sep) = false := by simpa using hc
    have hcs : ∀ d ∈ cs, d ≠ sep := fun d hd => h d (by simp [hd])
    simp only [List.cons_append, splitOnChar, hbeq, Bool.false_eq_true, ↓reduceIte]
    rw [ih hcs]

private theorem no_newline_append {l r : List Char}
    (hl : ∀ c ∈ l, c ≠ '\n') (hr : ∀ c ∈ r, c ≠ '\n') : ∀ c ∈ l ++ r, c ≠ '\n' := by
  intro c hc
  rcases List.mem_append.mp hc with h | h
  · exact hl c h
  · exact hr c h

private theorem no_nl_line1 : ∀ c ∈ line1.toList, c ≠ '\n' := by
  simp only [line1, String.toList_append]
  exact no_newline_append
    (no_newline_append (no_newline_append
      (by decide : ∀ c ∈ p1a.toList, c ≠ '\n')
      (by decide : ∀ c ∈ p1b.toList, c ≠ '\n'))
      (by decide : ∀ c ∈ p1c.toList, c ≠ '\n'))
    (by decide : ∀ c ∈ p1d.toList, c ≠ '\n')

private theorem no_nl_line2 : ∀ c ∈ line2.toList, c ≠ '\n' := by
  simp only [line2, String.toList_append]
  exact no_newline_append
    (no_newline_append (no_newline_append
      (by decide : ∀ c ∈ p2a.toList, c ≠ '\n')
      (by decide : ∀ c ∈ p2b.toList, c ≠ '\n'))
      (by decide : ∀ c ∈ p2c.toList, c ≠ '\n'))
    (by decide : ∀ c ∈ p2d.toList, c ≠ '\n')

private theorem newline_list : "\n".toList = ['\n'] := by decide

private theorem header_eq : header = (line1 ++ "\n") ++ (line2 ++ "\n") := by
  simp only [header, line1, line2]
  decide

private theorem header_toList :
    header.toList = line1.toList ++ '\n' :: (line2.toList ++ '\n' :: []) := by
  rw [header_eq]
  simp only [String.toList_append, newline_list, List.append_assoc, List.cons_append,
    List.nil_append]

private theorem header_split :
    splitOnChar '\n' header.toList = [line1.toList, line2.toList, []] := by
  rw [header_toList, splitOnChar_append_sep no_nl_line1, splitOnChar_append_sep no_nl_line2]
  simp [splitOnChar]

private theorem head_append {l r : List Char} {c : Char} (h : l.head? = some c) :
    (l ++ r).head? = some c := by
  cases l <;> simp_all

private theorem line1_head : line1.toList.head? = some '#' := by
  have h : p1a.toList.head? = some '#' := by decide
  simp only [line1, String.toList_append, List.append_assoc]
  exact head_append h

private theorem line2_head : line2.toList.head? = some '#' := by
  have h : p2a.toList.head? = some '#' := by decide
  simp only [line2, String.toList_append, List.append_assoc]
  exact head_append h

-- The two lines are named by `header_eq`. Folding them here, instead of splitting `header`
-- again, keeps the later claims from reducing `splitOnChar` on the whole header.
attribute [irreducible] line1 line2

private def headerWithLine (i : Nat) (line : List Char) : String :=
  match i with
  | 0 => String.ofList (joinLines [line, line2.toList, []])
  | 1 => String.ofList (joinLines [line1.toList, line, []])
  | _ => ""

-- Evaluated on its own, so a matcher that compares only the first line fails this
-- claim even when a later proof is where elaboration stops.
#guard !firstTwoLinesMatchHeader (headerWithLine 1 otherLine)

private theorem not_empty_of_head {l : List Char} {c : Char} (h : l.head? = some c) :
    l.isEmpty = false := by
  cases l <;> simp_all

private theorem beq_false_nil {l : List Char} {c : Char} (h : l.head? = some c) :
    (l == ([] : List Char)) = false := by
  cases l <;> simp_all

private theorem beq_false_of_head {l r : List Char} {a b : Char}
    (hl : l.head? = some a) (hr : r.head? = some b) (hab : (a == b) = false) :
    (l == r) = false := by
  cases l <;> cases r <;> simp_all



private theorem both_lines (l1 l2 : List Char) (h1 : l1.isEmpty = false) (h2 : l2.isEmpty = false) :
    (!l1.isEmpty && !l2.isEmpty && l1 == l1 && l2 == l2) = true := by
  simp [h1, h2]

private theorem apply_header (txt : String) :
    firstTwoLinesMatchHeader txt =
      match splitOnChar '\n' txt.toList with
      | l1 :: l2 :: _ =>
        !line1.toList.isEmpty && !line2.toList.isEmpty && line1.toList == l1 && line2.toList == l2
      | _ => false := by
  unfold firstTwoLinesMatchHeader
  rw [header_split]

-- Later claims rewrite this lemma. Leaving the matcher reducible makes the kernel
-- reduce `splitOnChar` again for each of them.
attribute [irreducible] firstTwoLinesMatchHeader

private theorem self_match : firstTwoLinesMatchHeader header = true := by
  rw [apply_header, header_split]
  exact both_lines _ _ (not_empty_of_head line1_head) (not_empty_of_head line2_head)

example : firstTwoLinesMatchHeader header = true := self_match

example : firstTwoLinesMatchHeader "" = false := by
  rw [apply_header, String.toList_empty, splitOnChar]

private def followingBody : String := "ctor Mitos.X type=ab"

private theorem no_nl_following : ∀ c ∈ followingBody.toList, c ≠ '\n' := by decide

private theorem following_eq : "ctor Mitos.X type=ab\n" = followingBody ++ "\n" := by decide

private theorem following_split :
    splitOnChar '\n' (header ++ "ctor Mitos.X type=ab\n").toList =
      [line1.toList, line2.toList, followingBody.toList, []] := by
  rw [following_eq]
  have form : (header ++ (followingBody ++ "\n")).toList =
      header.toList ++ (followingBody.toList ++ '\n' :: []) := by
    simp only [String.toList_append, newline_list]
  rw [form, header_toList, List.append_assoc, List.cons_append, List.append_assoc,
    List.singleton_append, splitOnChar_append_sep no_nl_line1,
    splitOnChar_append_sep no_nl_line2, splitOnChar_append_sep no_nl_following]
  simp [splitOnChar]

example : firstTwoLinesMatchHeader (header ++ "ctor Mitos.X type=ab\n") = true := by
  rw [apply_header, following_split]
  exact both_lines _ _ (not_empty_of_head line1_head) (not_empty_of_head line2_head)

private def onlyFirstLine : String := String.ofList (line1.toList ++ ['\n'])

private theorem onlyFirst_split :
    splitOnChar '\n' onlyFirstLine.toList = [line1.toList, []] := by
  unfold onlyFirstLine
  rw [String.toList_ofList, splitOnChar_append_sep no_nl_line1]
  simp [splitOnChar]

example : firstTwoLinesMatchHeader onlyFirstLine = false := by
  rw [apply_header, onlyFirst_split]
  simp [not_empty_of_head line1_head, not_empty_of_head line2_head, beq_false_nil line2_head]

private theorem join_two (a b : List Char) :
    joinLines [a, b, []] = a ++ '\n' :: b ++ '\n' :: [] := by
  simp [joinLines]

private theorem with0 (line : List Char) :
    headerWithLine 0 line = String.ofList (line ++ '\n' :: line2.toList ++ '\n' :: []) := by
  simp only [headerWithLine, join_two]

private theorem with1 (line : List Char) :
    headerWithLine 1 line = String.ofList (line1.toList ++ '\n' :: line ++ '\n' :: []) := by
  simp only [headerWithLine, join_two]

attribute [irreducible] headerWithLine

private theorem no_nl_other : ∀ c ∈ otherLine, c ≠ '\n' := by decide

private theorem other_head : otherLine.head? = some 'o' := by rfl

private theorem hash_ne_o : ('#' == 'o') = false := by decide

private theorem replaced_split (i : Nat) (line : List Char) (hn : ∀ c ∈ line, c ≠ '\n')
    (h0 : i = 0) :
    splitOnChar '\n' (headerWithLine i line).toList = [line, line2.toList, []] := by
  subst h0
  rw [with0, String.toList_ofList, List.append_assoc, List.cons_append,
    splitOnChar_append_sep hn, splitOnChar_append_sep no_nl_line2]
  simp [splitOnChar]

private theorem replaced_split1 (line : List Char) (hn : ∀ c ∈ line, c ≠ '\n') :
    splitOnChar '\n' (headerWithLine 1 line).toList = [line1.toList, line, []] := by
  rw [with1, String.toList_ofList, List.append_assoc, List.cons_append,
    splitOnChar_append_sep no_nl_line1, splitOnChar_append_sep hn]
  simp [splitOnChar]

private theorem roundtrip0 :
    splitOnChar '\n' (headerWithLine 0 line1.toList).toList = [line1.toList, line2.toList, []] :=
  replaced_split 0 line1.toList no_nl_line1 rfl

private theorem roundtrip1 :
    splitOnChar '\n' (headerWithLine 1 line2.toList).toList = [line1.toList, line2.toList, []] :=
  replaced_split1 line2.toList no_nl_line2

example : firstTwoLinesMatchHeader (headerWithLine 0 line1.toList) = true := by
  rw [apply_header, roundtrip0]
  exact both_lines _ _ (not_empty_of_head line1_head) (not_empty_of_head line2_head)

example : firstTwoLinesMatchHeader (headerWithLine 1 line2.toList) = true := by
  rw [apply_header, roundtrip1]
  exact both_lines _ _ (not_empty_of_head line1_head) (not_empty_of_head line2_head)

example : firstTwoLinesMatchHeader (headerWithLine 0 otherLine) = false := by
  rw [apply_header, replaced_split 0 otherLine no_nl_other rfl]
  simp [beq_false_of_head line1_head other_head hash_ne_o, Bool.and_false]

example : firstTwoLinesMatchHeader (headerWithLine 1 otherLine) = false := by
  rw [apply_header, replaced_split1 otherLine no_nl_other]
  simp [beq_false_of_head line2_head other_head hash_ne_o, Bool.and_false]

private def sha256Short (s : String) : IO String := do
  return ((← sha256 s).take 32).toString

private def digest (e : Expr) : IO String := sha256Short (toString e)

def generatedSuffixes : List String :=
  ["rec", "sizeOf_spec", "noConfusionType", "ctorIdx", "ofNat_ctorIdx", "toCtorIdx", "ofNat",
   "ctorElim", "ctorElimType", "inj", "injEq", "repr", "decEq"]

def isGenerated (n : Name) : Bool :=
  match n with
  | .str _ s => generatedSuffixes.contains s || s.startsWith "match_" || s.startsWith "eq_" ||
                s.startsWith "proof_"
  | _ => false

def pinned : ConstantInfo → List Expr
  | .defnInfo d => [d.type, d.value]
  | ci => [ci.type]

partial def unlistedDeps (env : Environment) (unlisted : Name → Bool) (es : List Expr)
    (seen : NameSet := {}) : NameSet :=
  es.foldl (init := seen) fun seen e =>
    e.getUsedConstants.foldl (init := seen) fun seen n =>
      if seen.contains n || !unlisted n then seen
      else match env.find? n with
        | some ci => unlistedDeps env unlisted (pinned ci) (seen.insert n)
        | none => seen

def entries (root : Name) (prefixes : List Name) : IO (Array String) := do
  initSearchPath (← findSysroot)
  let env ← importModules #[{ module := root }] {} (trustLevel := 0)
  let inCore (n : Name) : Bool := match env.getModuleIdxFor? n with
    | some idx => prefixes.any (·.isPrefixOf env.header.moduleNames[idx.toNat]!)
    | none => false
  let listed (n : Name) : Bool := inCore n &&
    !(n.isInternal || isAuxRecursor env n || isNoConfusion env n || isGenerated n)
  let mut out : Array String := #[]
  for (n, ci) in env.constants.map₁.toList do
    unless listed n do continue
    let ty ← digest ci.type
    let line ← match ci with
      | .defnInfo d => pure s!"def {n} type={ty} value={← digest d.value}"
      | .thmInfo _ => pure s!"theorem {n} type={ty}"
      | .inductInfo _ => pure s!"inductive {n} type={ty}"
      | .ctorInfo _ => pure s!"ctor {n} type={ty}"
      | .opaqueInfo _ => pure s!"opaque {n} type={ty}"
      | .axiomInfo _ => pure s!"AXIOM {n} type={ty}"
      | _ => pure s!"other {n} type={ty}"
    let deps := (unlistedDeps env (fun m => inCore m && !listed m) (pinned ci)).toList.toArray
    if deps.isEmpty then out := out.push line; continue
    let aux ← (deps.qsort (·.toString < ·.toString)).mapM fun m => do
      let ds ← (pinned (env.find? m).get!).mapM digest
      return s!"{m} {" ".intercalate ds}"
    out := out.push s!"{line} aux={← sha256Short ("\n".intercalate aux.toList)}"
  return out.qsort (· < ·)

def render (es : Array String) : String :=
  header ++ String.intercalate "\n" es.toList ++ "\n"

end MitosGate.Lock
