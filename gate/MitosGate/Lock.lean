import Lean
import MitosGate.Util
import MitosGate.Lock.Canon

/-!
(`Expr.hash` is not used: its effective width is 32 bits.)
-/

open Lean

namespace MitosGate.Lock

def header : String :=
  "# statements.lock: generated by `lake exe mitos-gate lock`. Do not edit by hand.\n" ++
  "# A change to this file needs the `spec-approved` label (see docs/process.md).\n" ++
  "# format: canon-1\n"

def startsWithHeader (txt : String) : Bool :=
  txt.startsWith header

theorem startsWithHeader_iff (txt : String) :
    startsWithHeader txt = true ↔ ∃ rest, txt = header ++ rest := by
  simp only [startsWithHeader, String.startsWith_string_iff]
  constructor
  · rintro ⟨t, ht⟩
    exact ⟨String.ofList t, String.toList_injective (by simp [← ht])⟩
  · rintro ⟨rest, rfl⟩
    exact ⟨rest.toList, by simp⟩

theorem header_ne_empty : header ≠ "" := by decide

example : startsWithHeader header = true :=
  (startsWithHeader_iff _).2 ⟨"", String.append_empty.symm⟩

example : startsWithHeader (header ++ "ctor Mitos.X type=ab\n") = true :=
  (startsWithHeader_iff _).2 ⟨_, rfl⟩

example : startsWithHeader "" = false := by
  cases h : startsWithHeader "" with
  | false => rfl
  | true =>
    obtain ⟨rest, hr⟩ := (startsWithHeader_iff _).1 h
    exact absurd (String.append_eq_empty_iff.1 hr.symm).1 header_ne_empty

private def sha256Short (s : String) : IO String := do
  return ((← sha256 s).take 32).toString

private def digest (e : Expr) : IO String := sha256Short (toString e)

def generatedSuffixes : List String :=
  ["rec", "sizeOf_spec", "noConfusionType", "ctorIdx", "ofNat_ctorIdx", "toCtorIdx", "ofNat",
   "ctorElim", "ctorElimType", "inj", "injEq", "repr", "decEq"]

def isGenerated (env : Environment) (n : Name) : Bool :=
  let numbered (pre s : String) :=
    let suffix := s.drop pre.length
    s.startsWith pre && !suffix.isEmpty && suffix.toString.toList.all Char.isDigit
  let isMatcher (m : Name) := match env.getModuleIdxFor? m with
    | some idx => (Meta.Match.Extension.extension.getModuleEntries env idx).any (·.name == m)
    | none => false
  match n with
  | .str p s => generatedSuffixes.contains s || isMatcher n ||
      (s.startsWith "eq_" && (env.find? n).all (·.type.getUsedConstants.contains p) &&
        (if isMatcher p then numbered "eq_" s else isReservedName env n)) || numbered "proof_" s
  | _ => false

def pinned : ConstantInfo → List Expr
  | .defnInfo d => [d.type, d.value]
  | ci => [ci.type]

partial def unlistedDeps (env : Environment) (unlisted : Name → Bool) (es : List Expr)
    (seen : NameSet := {}) : NameSet :=
  es.foldl (init := seen) fun seen e =>
    e.getUsedConstants.foldl (init := seen) fun seen n =>
      if seen.contains n || !unlisted n then seen
      else match env.find? n with
        | some ci => unlistedDeps env unlisted (pinned ci) (seen.insert n)
        | none => seen

structure ImportedRoot where
  private mk ::
  root : Name
  env : Environment

def importRoot (root : Name) : IO ImportedRoot := do
  initSearchPath (← findSysroot)
  return ⟨root, ← importModules #[{ module := root }] {} (trustLevel := 0)⟩

/-- Pre-canonical digest lines: `sha256` of `toString`, plus `aux=`. `lock --text` prints them. The checked lock is `entries`. -/
def textEntries (env : Environment) (prefixes : List Name) : IO (Array String) := do
  let inCore (n : Name) : Bool := match env.getModuleIdxFor? n with
    | some idx => prefixes.any (·.isPrefixOf env.header.moduleNames[idx.toNat]!)
    | none => false
  let listed (n : Name) : Bool := inCore n &&
    !(n.isInternal || isAuxRecursor env n || isNoConfusion env n || isGenerated env n)
  let mut out : Array String := #[]
  for (n, ci) in env.constants.map₁.toList do
    unless listed n do continue
    let ty ← digest ci.type
    let line ← match ci with
      | .defnInfo d => pure s!"def {n} type={ty} value={← digest d.value}"
      | .thmInfo _ => pure s!"theorem {n} type={ty}"
      | .inductInfo _ => pure s!"inductive {n} type={ty}"
      | .ctorInfo _ => pure s!"ctor {n} type={ty}"
      | .opaqueInfo _ => pure s!"opaque {n} type={ty}"
      | .axiomInfo _ => pure s!"AXIOM {n} type={ty}"
      | _ => pure s!"other {n} type={ty}"
    let deps := (unlistedDeps env (fun m => inCore m && !listed m) (pinned ci)).toList.toArray
    if deps.isEmpty then out := out.push line; continue
    let aux ← (deps.qsort (·.toString < ·.toString)).mapM fun m => do
      let ds ← (pinned (env.find? m).get!).mapM digest
      return s!"{m} {" ".intercalate ds}"
    out := out.push s!"{line} aux={← sha256Short ("\n".intercalate aux.toList)}"
  return out.qsort (· < ·)

def kindOf : ConstantInfo → String
  | .defnInfo _ => "def"
  | .thmInfo _ => "theorem"
  | .inductInfo _ => "inductive"
  | .ctorInfo _ => "ctor"
  | .opaqueInfo _ => "opaque"
  | .axiomInfo _ => "AXIOM"
  | _ => "other"

def isSkeleton : ConstantInfo → Bool
  | .inductInfo _ | .ctorInfo _ | .recInfo _ => true
  | _ => false

def blockedMeaning : ConstantInfo → Bool
  | .opaqueInfo _ | .axiomInfo _ => true
  | ci => ci.isUnsafe

def meaningPin (params : Nat) (typeEnc : String) (valueEnc : Option String) : String :=
  match valueEnc with
  | some v => s!"params={params} type={typeEnc} value={v}"
  | none => s!"params={params} type={typeEnc}"

inductive Origin where
  | spec
  | toolchain
  | package (name : String)
  deriving Repr, BEq

def coreBuildSuffix : List String := ["core", ".lake", "build", "lib", "lean"]

example :
    coreBuildSuffix.isSuffixOf ["", "repo", "core", ".lake", "build", "lib", "lean"] = true := by
  decide

example : coreBuildSuffix.isSuffixOf ["", "repo", ".lake", "packages", "toy", ".lake", "build", "lib", "lean"] = false := by
  decide

structure GitPin where
  name : String
  url : String
  rev : String
  deriving DecidableEq, Repr

def duplicatePins (which : String) : List GitPin → List String → List String
  | [], _ => []
  | p :: ps, seen =>
    let here :=
      if seen.contains p.name then
        [s!"package {p.name} is duplicated in the {which} lake-manifest.json"]
      else
        []
    here ++ duplicatePins which ps (p.name :: seen)

def missingPins (from_ to_ : String) (have_ lack : List GitPin) : List String :=
  have_.filterMap fun p =>
    if lack.any (·.name == p.name) then none
    else some s!"package {p.name} is in the {from_} lake-manifest.json and missing from the {to_} lake-manifest.json"

def changedPins (root core : List GitPin) : List String :=
  root.filterMap fun p =>
    match core.find? (·.name == p.name) with
    | none => none
    | some q =>
      if p.url == q.url && p.rev == q.rev then none
      else some s!"package {p.name} differs between the root and core lake-manifest.json"

def gitPinDisagreements (root core : List GitPin) : List String :=
  duplicatePins "root" root [] ++ duplicatePins "core" core [] ++
    missingPins "root" "core" root core ++ missingPins "core" "root" core root ++
    changedPins root core

example : gitPinDisagreements [] [] = [] := by decide

example : gitPinDisagreements [⟨"a", "u", "1"⟩] [⟨"a", "u", "1"⟩] = [] := by decide

example : gitPinDisagreements [⟨"a", "u", "1"⟩] [⟨"a", "u", "2"⟩] =
    ["package a differs between the root and core lake-manifest.json"] := by decide

example : gitPinDisagreements [⟨"a", "u", "1"⟩] [] =
    ["package a is in the root lake-manifest.json and missing from the core lake-manifest.json"] := by
  decide

example : gitPinDisagreements [] [⟨"a", "u", "1"⟩] =
    ["package a is in the core lake-manifest.json and missing from the root lake-manifest.json"] := by
  decide

example : gitPinDisagreements [⟨"a", "u", "1"⟩, ⟨"a", "u", "1"⟩] [⟨"a", "u", "1"⟩] =
    ["package a is duplicated in the root lake-manifest.json"] := by decide

def nameListed (env : Environment) (n : Name) : Bool :=
  !(n.isInternal || isAuxRecursor env n || isNoConfusion env n || isGenerated env n)

def specModule (env : Environment) (prefixes : List Name) (n : Name) : Bool :=
  match env.getModuleIdxFor? n with
  | some idx => prefixes.any (·.isPrefixOf env.header.moduleNames[idx.toNat]!)
  | none => false

structure Roots where
  sysroot : System.FilePath
  packages : Array (String × System.FilePath)

private def jsonStr (j : Json) (k : String) : Except String String := do
  (← j.getObjVal? k).getStr?

private def badComponent (c : String) : Bool :=
  c.isEmpty || c == "." || c == ".."

def parsePackagesDir (j : Json) : Except String System.FilePath := do
  let s ← jsonStr j "packagesDir"
  let p : System.FilePath := s
  if s.isEmpty || p.isAbsolute || p.components.any badComponent then
    throw s!"root lake-manifest.json packagesDir {s} is not a relative path inside the workspace"
  return p

private def badPackageName (name : String) : Bool :=
  name.isEmpty || name == "." || name == ".." ||
    name.toList.any fun c => c == '/' || c == '\\' || c == '\n' || c == '\r'

def packageNames (which : String) (j : Json) : Except String (List String) := do
  let arr ← (← j.getObjVal? "packages").getArr?
  let mut names : List String := []
  let mut out : List String := []
  for entry in arr do
    let name ← jsonStr entry "name"
    if badPackageName name then
      throw s!"{which} lake-manifest.json package name {name} is not a single path component"
    if names.contains name then
      throw s!"{which} lake-manifest.json duplicates package {name}"
    names := name :: names
    out := out ++ [name]
  return out

def parseGitPins (which : String) (j : Json) : Except String (List GitPin) := do
  let arr ← (← j.getObjVal? "packages").getArr?
  let mut pins : List GitPin := []
  for entry in arr do
    let ty ← jsonStr entry "type"
    match ty with
    | "path" => pure ()
    | "git" =>
      let name ← jsonStr entry "name"
      let field (k : String) : Except String String := do
        match jsonStr entry k with
        | .ok s =>
          if s.isEmpty then
            throw s!"{which} lake-manifest.json git package {name} lacks a name, url, or rev"
          pure s
        | .error _ =>
          throw s!"{which} lake-manifest.json git package {name} lacks a name, url, or rev"
      let url ← field "url"
      let rev ← field "rev"
      if badPackageName name then
        throw s!"{which} lake-manifest.json git package {name} lacks a name, url, or rev"
      pins := pins ++ [⟨name, url, rev⟩]
    | other =>
      throw s!"{which} lake-manifest.json has unknown package type {other}"
  return pins

def readManifest (path : System.FilePath) (which : String) : IO Json := do
  let txt ← try
    IO.FS.readFile path
  catch e =>
    throw <| IO.userError s!"{which} manifest {path} cannot be read: {e}"
  match Json.parse txt with
  | .ok j => return j
  | .error e => throw <| IO.userError s!"{which} manifest {path} is not JSON: {e}"

private def liftExcept (r : Except String α) : IO α :=
  match r with
  | .ok a => pure a
  | .error e => throw <| IO.userError e

def manifestStatus : IO UInt32 := do
  try
    let root ← readManifest "lake-manifest.json" "root"
    let core ← readManifest "core/lake-manifest.json" "core"
    discard <| liftExcept (parsePackagesDir root)
    discard <| liftExcept (packageNames "root" root)
    discard <| liftExcept (packageNames "core" core)
    let rootPins ← liftExcept (parseGitPins "root" root)
    let corePins ← liftExcept (parseGitPins "core" core)
    let diff := gitPinDisagreements rootPins corePins
    if diff.isEmpty then
      return 0
    IO.println (ciLine ("root and core manifests disagree: " ++ "; ".intercalate diff))
    return 1
  catch e =>
    IO.println (ciLine s!"{e}")
    return 1

def moduleOLeanSuffix (mod : Name) : Except String (List String) :=
  let rec go : Name → Except String (List String)
    | .anonymous => .ok []
    | .str p s => do
      if s.isEmpty then
        throw s!"module {mod} has an empty component"
      return (← go p) ++ [s]
    | .num _ _ => .error s!"module {mod} has a numeric component"
  do
    let cs ← go mod
    match cs.getLast? with
    | none => .error s!"module {mod} is anonymous"
    | some last => .ok (cs.dropLast ++ [last ++ ".olean"])

def oleanRoot (mod : Name) : IO System.FilePath := do
  let file ← realPathNormalized (← findOLean mod)
  let suf ← liftExcept (moduleOLeanSuffix mod)
  match suf.isSuffixOf? file.components with
  | none =>
    throw <| IO.userError s!"olean path {file} does not end with the path of module {mod}"
  | some root => realPathNormalized (System.mkFilePath root)

def loadRoots : IO Roots := do
  let sysroot ← realPathNormalized ((← findSysroot) / "lib" / "lean")
  let loaded : Option (System.FilePath × List String) ← try
    let j ← readManifest "lake-manifest.json" "root"
    pure (some (← liftExcept (parsePackagesDir j), ← liftExcept (packageNames "root" j)))
  catch _ =>
    pure none
  let mut packages : Array (String × System.FilePath) := #[]
  if let some (dir, names) := loaded then
    for name in names do
      let pkgRoot := dir / name
      if ← pkgRoot.isDir then
        packages := packages.push (name, ← realPathNormalized pkgRoot)
  return { sysroot, packages }

def underComponents (dir root : List String) : Bool :=
  !dir.isEmpty && dir.isPrefixOf root

def packageAtComponents (packages : List (String × List String)) (root : List String) : Option String :=
  let best := packages.foldl (init := none) fun best (name, dir) =>
    if underComponents dir root then
      match best with
      | none => some (name, dir.length)
      | some (prev, k) => if dir.length > k then some (name, dir.length) else some (prev, k)
    else
      best
  best.map (·.1)

def originOfComponents (sysroot : List String) (packages : List (String × List String))
    (mod : Name) (root : List String) (shown : String) : Except String Origin :=
  match packageAtComponents packages root with
  | some name =>
    if (`Mitos.Core).isPrefixOf mod then
      .error s!"module {mod} is Mitos.Core.* but its .olean is in package {name}"
    else
      .ok (.package name)
  | none =>
    if root == sysroot then
      .ok .toolchain
    else if coreBuildSuffix.isSuffixOf root && (`Mitos.Core).isPrefixOf mod then
      .ok .spec
    else
      .error s!"module {mod} .olean at {shown} is not the toolchain, core's build, or a package in the root manifest"

def originOf (roots : Roots) (mod : Name) (root : System.FilePath) : Except String Origin :=
  originOfComponents roots.sysroot.components
    (roots.packages.toList.map fun (n, dir) => (n, dir.components)) mod root.components (toString root)

example : underComponents [".lake", "packages", "badname"]
    [".lake", "packages", "badname", "core", ".lake", "build", "lib", "lean"] = true := by
  decide

example : underComponents [".lake", "packages", "bad"]
    [".lake", "packages", "badname", "core", ".lake", "build", "lib", "lean"] = false := by
  decide

example : packageAtComponents [("badname", ["", "repo", ".lake", "packages", "badname"])]
    ["", "repo", ".lake", "packages", "badname", "core", ".lake", "build", "lib", "lean"] = some "badname" := by
  decide

example : packageAtComponents [] ["", "repo", "core", ".lake", "build", "lib", "lean"] = none := by
  decide

example : coreBuildSuffix.isSuffixOf ["", "repo", ".lake", "build", "lib", "lean"] = false := by
  decide

def classify (roots : Roots) (mod : Name) : IO (Except String Origin) := do
  let root ← try
    pure (← oleanRoot mod)
  catch e =>
    return .error s!"module {mod}: {e}"
  return originOf roots mod root

structure Place where
  env : Environment
  prefixes : List Name
  roots : Roots
  modules : IO.Ref (NameMap Origin)
  consts : IO.Ref (NameMap Origin)
  memo : IO.Ref (NameMap String)

def moduleOrigin (p : Place) (mod : Name) : IO Origin := do
  if let some o := (← p.modules.get).find? mod then
    return o
  match ← classify p.roots mod with
  | .error e => throw <| IO.userError e
  | .ok o =>
    p.modules.modify (·.insert mod o)
    return o

def constOrigin (p : Place) (n : Name) : IO Origin := do
  if let some o := (← p.consts.get).find? n then
    return o
  let some idx := p.env.getModuleIdxFor? n
    | throw <| IO.userError s!"declaration {n} has no module"
  let some mod := p.env.header.moduleNames[idx.toNat]?
    | throw <| IO.userError s!"declaration {n} has no module"
  let o ← moduleOrigin p mod
  p.consts.modify (·.insert n o)
  return o

def warm (p : Place) (es : List Expr) : IO Unit := do
  for e in es do
    for n in e.getUsedConstants do
      discard <| constOrigin p n

def specListed (p : Place) (n : Name) : IO Bool := do
  match ← constOrigin p n with
  | .spec => return specModule p.env p.prefixes n && nameListed p.env n
  | _ => return false

def packageListed (p : Place) (n : Name) : IO Bool := do
  match ← constOrigin p n with
  | .package _ => return nameListed p.env n
  | _ => return false

def folds (p : Place) (n : Name) : IO Bool := do
  let some ci := p.env.find? n | return false
  if isSkeleton ci then return false
  match ← constOrigin p n with
  | .toolchain => return false
  | .spec => return !(← specListed p n) && !blockedMeaning ci
  | .package _ =>
    if ← packageListed p n then return false
    if ci matches .axiomInfo _ || ci.isUnsafe then return false
    if ci matches .opaqueInfo _ then return false
    return true

def refOf (env : Environment) (origins : NameMap Origin) (specListedOf packageListedOf : Name → Bool)
    (memo : NameMap String) (n : Name) : Except String Canon.Ref := do
  let some origin := origins.find? n | throw s!"origin of {n} is not ready"
  match origin with
  | .toolchain => return .named n
  | .spec =>
    if specListedOf n then
      if n.hasMacroScopes then
        throw s!"listed declaration {n} has a macro scope"
      return .named n
    match env.find? n with
    | none => throw s!"missing declaration {n}"
    | some ci =>
      if isSkeleton ci then
        return .named n
      if blockedMeaning ci then
        throw s!"unlisted declaration {n} is opaque, an axiom, or unsafe"
      match memo.find? n with
      | some d => return .byMeaning d
      | none => throw s!"canonical digest of {n} is not ready"
  | .package pkg =>
    match env.find? n with
    | none => throw s!"missing declaration {n}"
    | some ci =>
      if ci matches .axiomInfo _ then
        throw s!"reached axiom {n} in package {pkg}"
      if ci.isUnsafe then
        throw s!"reached unsafe declaration {n} in package {pkg}"
      if packageListedOf n then
        if n.hasMacroScopes then
          throw s!"listed declaration {n} has a macro scope"
        return .named n
      if isSkeleton ci then
        return .named n
      if ci matches .opaqueInfo _ then
        throw s!"reached unlisted opaque {n} in package {pkg}"
      match memo.find? n with
      | some d => return .byMeaning d
      | none => throw s!"canonical digest of {n} is not ready"

def fromCanon {α : Type} (n : Name) (r : Except String α) : IO α :=
  match r with
  | .ok a => pure a
  | .error e => throw <| IO.userError s!"{n}: {e}"

def declLine (ci : ConstantInfo) (n : Name) (typeDig : String) (valueDig : Option String) : String :=
  let base := s!"{kindOf ci} {n} params={ci.levelParams.length} type={typeDig}"
  match valueDig with
  | some v => s!"{base} value={v}"
  | none => base

def extOrder (ci : ConstantInfo) : String :=
  match ci with
  | .ctorInfo v => s!" cidx={v.cidx}"
  | .inductInfo v => s!" ctors={",".intercalate (v.ctors.map toString)}"
  | _ => ""

def extLine (ci : ConstantInfo) (n : Name) (typeDig : String) (valueDig : Option String) : String :=
  s!"ext {declLine ci n typeDig valueDig}{extOrder ci}"

partial def ensure (p : Place) (n : Name) (stack : List Name) : IO Unit := do
  if (← p.memo.get).contains n then return
  if stack.contains n then
    throw <| IO.userError s!"canonical digest of {n} depends on itself"
  let some ci := p.env.find? n | return
  warm p (pinned ci)
  for e in pinned ci do
    for d in e.getUsedConstants do
      if ← folds p d then
        ensure p d (n :: stack)
  let origins ← p.consts.get
  let memoNow ← p.memo.get
  let specOf := fun m => specModule p.env p.prefixes m && nameListed p.env m &&
    match origins.find? m with
    | some .spec => true
    | _ => false
  let pkgOf := fun m => nameListed p.env m &&
    match origins.find? m with
    | some (.package _) => true
    | _ => false
  let ref := refOf p.env origins specOf pkgOf memoNow
  let levels := ci.levelParams
  let ty ← fromCanon n (Canon.canon levels ref ci.type)
  let valueEnc ← match ci with
    | .defnInfo d =>
      let v ← fromCanon n (Canon.canon levels ref d.value)
      pure (some v.encode)
    | _ => pure none
  let dig ← sha256Short (meaningPin levels.length ty.encode valueEnc)
  p.memo.modify (·.insert n dig)

def lineOf (p : Place) (n : Name) (ci : ConstantInfo) (ext : Bool) : IO String := do
  warm p (pinned ci)
  for e in pinned ci do
    for d in e.getUsedConstants do
      if ← folds p d then
        ensure p d []
  let origins ← p.consts.get
  let memoNow ← p.memo.get
  let specOf := fun m => specModule p.env p.prefixes m && nameListed p.env m &&
    match origins.find? m with
    | some .spec => true
    | _ => false
  let pkgOf := fun m => nameListed p.env m &&
    match origins.find? m with
    | some (.package _) => true
    | _ => false
  let ref := refOf p.env origins specOf pkgOf memoNow
  let levels := ci.levelParams
  let ty ← fromCanon n (Canon.canon levels ref ci.type)
  let valueDig ← match ci with
    | .defnInfo d =>
      let v ← fromCanon n (Canon.canon levels ref d.value)
      pure (some (← sha256Short v.encode))
    | _ => pure none
  let typeDig ← sha256Short ty.encode
  return if ext then extLine ci n typeDig valueDig else declLine ci n typeDig valueDig

def refuseReached (p : Place) (n : Name) (ci : ConstantInfo) : IO Unit := do
  match ← constOrigin p n with
  | .spec =>
    if !(← specListed p n) && blockedMeaning ci then
      throw <| IO.userError s!"unlisted declaration {n} is opaque, an axiom, or unsafe"
  | .package pkg =>
    if ci matches .axiomInfo _ then
      throw <| IO.userError s!"reached axiom {n} in package {pkg}"
    if ci.isUnsafe then
      throw <| IO.userError s!"reached unsafe declaration {n} in package {pkg}"
    if !(← packageListed p n) && ci matches .opaqueInfo _ then
      throw <| IO.userError s!"reached unlisted opaque {n} in package {pkg}"
  | .toolchain => pure ()

def emitExt (p : Place) (n : Name) : IO Bool := do
  match ← constOrigin p n with
  | .package _ =>
    let some ci := p.env.find? n | return false
    if ci matches .axiomInfo _ || ci.isUnsafe then return false
    if isSkeleton ci then return true
    return nameListed p.env n
  | _ => return false

partial def collect (p : Place) (n : Name) (seen : NameSet) : IO NameSet := do
  if seen.contains n then return seen
  let mut seen := seen.insert n
  let some ci := p.env.find? n | return seen
  refuseReached p n ci
  if let .inductInfo val := ci then
    unless (← constOrigin p n) matches .toolchain do
      for ctor in val.ctors do
        seen ← collect p ctor seen
  warm p (pinned ci)
  for e in pinned ci do
    for d in e.getUsedConstants do
      let some dci := p.env.find? d | continue
      refuseReached p d dci
      let recurse ← match ← constOrigin p d with
        | .toolchain => pure false
        | .spec =>
          if ← specListed p d then
            pure false
          else if isSkeleton dci then
            pure true
          else
            pure !blockedMeaning dci
        | .package _ => pure true
      if recurse then
        seen ← collect p d seen
  return seen

def refuseMisplaced (p : Place) : IO Unit := do
  let mut msgs : Array String := #[]
  for mod in p.env.header.moduleNames do
    if (`Mitos.Core).isPrefixOf mod then
      try
        match ← moduleOrigin p mod with
        | .spec => pure ()
        | .toolchain =>
          msgs := msgs.push s!"module {mod} is Mitos.Core.* but its .olean is in the toolchain"
        | .package name =>
          msgs := msgs.push s!"module {mod} is Mitos.Core.* but its .olean is in package {name}"
      catch e =>
        msgs := msgs.push s!"{e}"
  unless msgs.isEmpty do
    throw <| IO.userError ("\n".intercalate msgs.toList)

def entries (env : Environment) (prefixes : List Name) : IO (Array String) := do
  let roots ← loadRoots
  let p : Place := {
    env, prefixes, roots
    modules := ← IO.mkRef {}
    consts := ← IO.mkRef {}
    memo := ← IO.mkRef {}
  }
  refuseMisplaced p
  let mut out : Array String := #[]
  let mut specRoots : Array Name := #[]
  for (n, ci) in env.constants.map₁.toList do
    unless specModule env prefixes n && nameListed env n do continue
    if n.hasMacroScopes then
      throw <| IO.userError s!"listed declaration {n} has a macro scope"
    specRoots := specRoots.push n
    out := out.push (← lineOf p n ci false)
  let mut seen : NameSet := {}
  for n in specRoots do
    seen ← collect p n seen
  let mut extNames : Array Name := #[]
  for n in seen do
    if ← emitExt p n then
      extNames := extNames.push n
  for n in extNames do
    if let some ci := env.find? n then
      out := out.push (← lineOf p n ci true)
  return out.qsort (· < ·)

def render (es : Array String) : String :=
  header ++ String.intercalate "\n" es.toList ++ "\n"

theorem startsWithHeader_render (es : Array String) :
    startsWithHeader (render es) = true :=
  (startsWithHeader_iff _).2 ⟨_, String.append_assoc ..⟩

def unreached (sources : List Name) (reached : Name → Bool) : List Name :=
  sources.filter (!reached ·)

theorem mem_unreached {sources : List Name} {reached : Name → Bool} {m : Name} :
    m ∈ unreached sources reached ↔ m ∈ sources ∧ reached m = false := by
  simp [unreached]

theorem unreached_eq_nil_iff (sources : List Name) (reached : Name → Bool) :
    unreached sources reached = [] ↔ ∀ m ∈ sources, reached m = true := by
  simp [unreached, List.filter_eq_nil_iff]

def moduleDir (base : System.FilePath) (root : Name) : System.FilePath :=
  modToFilePath base root ""

/-- Lake's
`Glob.forEachModuleIn` walks the folder with this same `forEachModuleInDir`, so a file is here
exactly when the library's glob names it as a module. -/
def sourceModules (base : System.FilePath) (root : Name) : IO (Array Name) := do
  let out ← IO.mkRef #[]
  forEachModuleInDir (moduleDir base root) fun m => out.modify (·.push (root ++ m))
  return (← out.get).qsort (·.toString < ·.toString)

end MitosGate.Lock
