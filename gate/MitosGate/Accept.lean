import MitosGate.Lint
import MitosGate.Util

namespace MitosGate.Accept

structure Config where
  mitosRoot  : System.FilePath := "."
  workspace  : System.FilePath
  plugin     : String
  model      : String
  pluginFile : Option System.FilePath := none
  paranoid   : Bool := false
  skipLint   : Bool := false
  record     : Bool := false
  keep       : Bool := false

def permittedAxioms : List String := ["propext", "Quot.sound", "Classical.choice"]

def pluginImports : List String := ["Init", "Std", "Mitos.Core", "Models"]

def obligationNames (p : String) : List String :=
  [s!"{p}.anchored", s!"{p}.sound", s!"{p}.complete"]

def modelModule (model : String) : String :=
  String.intercalate "." ((model.splitOn ".").dropLast)

/-- The models and `models.lock` exactly as gate 0 read and checked them. Only `provenance` builds
one, and every later gate and the record use these bytes instead of the workspace. -/
structure LockedModels where
  private mk ::
  model : String
  files : Array (String × String)
  lock  : String

def challenge (p model : String) : String :=
  s!"import Mitos.Core
import {modelModule model}

/-! Generated by mitos-gate. Do not edit: the statements here are what acceptance means. -/

-- Every name starts from `_root_`, the declared ones too. `theorem {p}.sound` would open
-- namespace `{p}` while elaborating its type, and Lean would look `_root_.Mitos.SoundWrt` up as
-- `{p}._root_.Mitos.SoundWrt` and `Mitos.SoundWrt` as `{p}.Mitos.SoundWrt` first, so a model
-- module that declared either would change what the Challenge states.
def _root_.{p}.extractor : _root_.Mitos.Extractor := sorry
theorem _root_.{p}.anchored : _root_.Mitos.Anchored _root_.{p}.extractor := sorry
theorem _root_.{p}.sound : _root_.Mitos.SoundWrt _root_.{model} _root_.{p}.extractor := sorry
theorem _root_.{p}.complete : _root_.Mitos.CompleteWrt _root_.{model} _root_.{p}.extractor := sorry
"

def quote (s : String) : String := "\"" ++ s ++ "\""

def comparatorJson (p : String) : String :=
  let thms := String.intercalate ", " ((obligationNames p).map quote)
  let axs := String.intercalate ", " (permittedAxioms.map quote)
  s!"\{\"challenge_module\": \"Challenge.{p}\", \"solution_module\": \"Plugins.{p}\",
 \"theorem_names\": [{thms}],
 \"definition_names\": [\"{p}.extractor\"],
 \"permitted_axioms\": [{axs}]}
"

def adequacyChallenge (m : LockedModels) : String :=
  s!"import Mitos.Core

/-! Generated by mitos-gate (gate 6). Do not edit: the statement here is what model adequacy means. -/

def _root_.{m.model} : _root_.Mitos.Model := sorry
def _root_.{m.model}.examples : _root_.Mitos.ModelExamples := sorry
theorem _root_.{m.model}.adequate :
    _root_.Mitos.Model.Adequate _root_.{m.model} _root_.{m.model}.examples := sorry
"

def adequacyComparatorJson (m : LockedModels) : String :=
  let axs := String.intercalate ", " (permittedAxioms.map quote)
  s!"\{\"challenge_module\": \"Challenge.ModelAdequacy\", \"solution_module\": \"{modelModule m.model}\",
 \"theorem_names\": [{quote s!"{m.model}.adequate"}],
 \"definition_names\": [{quote m.model}, {quote s!"{m.model}.examples"}],
 \"permitted_axioms\": [{axs}]}
"

def judgeLakefile : String :=
  "name = \"judge\"\n[[lean_lib]]\nname = \"Judge\"\n" ++
  "globs = [\"Mitos.Core\", \"Mitos.Core.+\", \"Models.+\", \"Plugins.+\", \"Challenge.+\"]\n"

def judgeManifest : String :=
  "{\"version\": \"1.3.0\", \"packagesDir\": \".lake/packages\", \"packages\": [], " ++
  "\"name\": \"judge\", \"lakeDir\": \".lake\", \"fixedToolchain\": false}\n"

def report (gate : Nat) (name : String) (ok : Bool) (detail : String := "") : IO Unit := do
  let status := if ok then "PASS" else "FAIL"
  IO.println s!"GATE {gate} {name}: {status}{if detail.isEmpty then "" else " — " ++ detail}"

private def validIdent (s : String) : Bool :=
  !s.isEmpty && s.toList.all (fun c => c.isAlphanum || c == '_') && (s.toList.head!).isAlpha

abbrev GateM := ExceptT (Nat × String) IO

def atGate (gate : Nat) (name : String) (x : GateM α) : GateM α :=
  tryCatchThe IO.Error x fun e => do
    report gate name false s!"I/O error: {e}"
    throw (gate, s!"{name}: I/O error")

def lockEntries (lock : String) : Except String (List (String × String)) :=
  (lock.splitOn "\n").filter (fun l => !l.isEmpty) |>.mapM fun l =>
    match l.splitOn "  " with
    | [h, path] =>
      if h.length == 64 && h.all (fun c => c.isDigit || ('a' ≤ c && c ≤ 'f')) then .ok (path, h)
      else .error s!"models.lock has a malformed line: {l}"
    | _ => .error s!"models.lock has a malformed line: {l}"

def provenance (c : Config) (pluginFile : System.FilePath) : GateM LockedModels := do
  let mut errs := #[]
  unless validIdent c.plugin do errs := errs.push s!"plugin name `{c.plugin}` is not a plain identifier"
  let parts := c.model.splitOn "."
  unless parts.length ≥ 3 && parts.head? == some "Models" && parts.all validIdent do
    errs := errs.push s!"model `{c.model}` is not a dotted identifier in Models, such as Models.Name.model"
  let wsTc := c.workspace / "lean-toolchain"
  let tc ← IO.FS.readFile (c.mitosRoot / "lean-toolchain")
  if !(← wsTc.pathExists) then errs := errs.push "workspace has no lean-toolchain"
  else if trim (← IO.FS.readFile wsTc) != trim tc then
    errs := errs.push s!"workspace toolchain differs from Mitos pin {trim tc}"
  if !(← pluginFile.pathExists) then errs := errs.push s!"plugin file {pluginFile} not found"
  let mut files := #[]
  for f in ← leanFiles (c.workspace / "Models") do
    files := files.push ((f.toString.drop (c.workspace.toString.length + 1)).toString, ← IO.FS.readFile f)
  let modelFile := ((System.mkFilePath parts.dropLast).addExtension "lean").toString
  unless files.any (·.1 == modelFile) do
    errs := errs.push s!"model module file {c.workspace / modelFile} not found"
  let lockFile := c.workspace / "models.lock"
  let lock ← if ← lockFile.pathExists then IO.FS.readFile lockFile else pure ""
  if lock.isEmpty then errs := errs.push "workspace has no models.lock"
  else match lockEntries lock with
    | .error e => errs := errs.push e
    | .ok listed =>
      for (rel, txt) in files do
        match List.lookup rel listed with
        | none => errs := errs.push s!"model {rel} is not in models.lock"
        | some h => unless h == (← sha256 txt) do
            errs := errs.push s!"models.lock does not match the models: {rel}: FAILED"
      for (path, _) in listed do
        unless files.any (·.1 == path) do
          errs := errs.push s!"models.lock lists {path}, which is not a model file"
  report 0 "provenance" errs.isEmpty (String.intercalate "; " errs.toList)
  unless errs.isEmpty do throw (0, "provenance")
  return { model := c.model, files, lock }

def lint (c : Config) (pluginFile : System.FilePath) (src : String) (m : LockedModels) :
    GateM Unit := do
  if c.skipLint then
    IO.println "GATE 1 lint: SKIPPED (--skip-lint: measuring the later gates only)"
    return
  let env ← Lint.syntaxEnv
  let mut shown := #[]
  for v in ← Lint.check env pluginImports src do shown := shown.push (v.render pluginFile.toString)
  for (rel, txt) in m.files do
    for v in ← Lint.checkModel env pluginImports txt do
      shown := shown.push (v.render (c.workspace / rel).toString)
  report 1 "lint" shown.isEmpty s!"{shown.size} violation(s)"
  for v in shown do IO.println s!"  {v}"
  unless shown.isEmpty do throw (1, "lint")

def statementMarkers : List String :=
  [ "Const not found in challenge", "Const not found in solution",
    "Const does not match between challenge and target",
    "Challenge and solution constant kind don't match",
    "Challenge and solution theorem statement do not match",
    "Challenge constant is not a definition", "Solution constant is not a definition" ]

def failedGate (comparatorOutput : String) : Nat × String :=
  let has (s : String) := (comparatorOutput.splitOn s).length > 1
  if has "Illegal axiom" then (4, "axioms")
  else if statementMarkers.any has || has "not found in environment" then (3, "statements")
  else if has "kernel" && has "reject" then (5, "kernels")
  else if has "error:" then (2, "sandbox build")
  else (3, "statements")

structure Judgment where
  accepted : Bool
  output   : String

def runComparator (c : Config) (dir : System.FilePath) (config : String) : IO Judgment := do
  let args := #["comparator", s!"--config={config}"] ++ if c.paranoid then #["--paranoid"] else #[]
  try
    let (code, out) ← run "lake" args dir
    return { accepted := code == 0 && (out.splitOn "Your solution is okay!").length > 1, output := out }
  catch e => return { accepted := false, output := s!"error: could not run lake comparator: {e}" }

/-- One judging directory, so gates 3 and 6 see one elaboration of the model. Gate 6 is judged
first, before the plugin is built, so nothing the plugin's build writes can reach it. Returns the
plugin's judgment (gates 2–5), then the model's (gate 6). -/
def judge (c : Config) (m : LockedModels) (src chal adequacyChal : String) :
    IO (Judgment × Judgment) := do
  let dir ← IO.FS.createTempDir
  try
    copyFile (c.mitosRoot / "lean-toolchain") (dir / "lean-toolchain")
    copyLeanTree (c.mitosRoot / "core" / "Mitos") (dir / "Mitos")
    let generated : List (System.FilePath × String) :=
      [ ("Plugins" / s!"{c.plugin}.lean", src), ("Challenge" / s!"{c.plugin}.lean", chal),
        ("comparator.json", comparatorJson c.plugin),
        ("Challenge" / "ModelAdequacy.lean", adequacyChal),
        ("adequacy.json", adequacyComparatorJson m),
        ("lakefile.toml", judgeLakefile), ("lake-manifest.json", judgeManifest) ]
    for (rel, txt) in m.files.toList.map (fun (r, t) => (⟨r⟩, t)) ++ generated do
      if let some p := (dir / rel).parent then IO.FS.createDirAll p
      IO.FS.writeFile (dir / rel) txt
    let model ← runComparator c dir "adequacy.json"
    let plugin ← runComparator c dir "comparator.json"
    return (plugin, model)
  finally
    if c.keep then IO.println s!"  (judging directory kept: {dir})" else IO.FS.removeDirAll dir

def showComparatorTail (out : String) : IO Unit := do
  let frame (l : String) := l == "backtrace:" || (l.startsWith "/" && (l.splitOn " [0x").length > 1)
  let lines := (out.splitOn "\n").filter fun l =>
    !(l.startsWith "✔") && !(l.startsWith "Exporting") && !frame l
  for l in lines.reverse.take 15 |>.reverse do IO.println s!"  | {l}"

def pluginGates (c : Config) (j : Judgment) : GateM Unit := do
  if !j.accepted then
    let (g, name) := failedGate j.output
    report g name false
    showComparatorTail j.output
    throw (g, name)
  report 2 "sandbox build" true
  report 3 "statements" true
  report 4 "axioms" true (String.intercalate ", " permittedAxioms)
  report 5 "kernels" true (if c.paranoid then "lean4lean, nanoda, con-leche, con-ron, paranoid" else "Lean kernel only (use --paranoid for independent kernels)")

def adequacyFailure (model out : String) : String :=
  let has (s : String) := (out.splitOn s).length > 1
  if has "not found in environment" || has "Const not found in solution" then
    s!"the model module must declare `{model}.examples` and `{model}.adequate`"
  else if has "Illegal axiom" then
    s!"`{model}.adequate` uses an axiom outside {String.intercalate ", " permittedAxioms}"
  else if statementMarkers.any has then
    s!"`{model}.adequate` does not state `Mitos.Model.Adequate {model} {model}.examples`"
  else if has "kernel" && has "reject" then s!"a kernel rejected `{model}.adequate`"
  else "the adequacy proof could not be judged"

def adequacyGate (m : LockedModels) (j : Judgment) : GateM Unit := do
  if !j.accepted then
    report 6 "model adequacy" false (adequacyFailure m.model j.output)
    showComparatorTail j.output
    throw (6, "model adequacy")
  report 6 "model adequacy" true
    s!"{m.model}.adequate : Mitos.Model.Adequate {m.model} {m.model}.examples"

def writeRecord (c : Config) (m : LockedModels) (src chal adequacyChal : String) : IO Unit := do
  let coreFiles ← leanFiles (c.mitosRoot / "core" / "Mitos")
  let mut coreCat := ""
  for f in coreFiles do coreCat := coreCat ++ f.toString ++ "\n" ++ (← IO.FS.readFile f)
  let rec_ := s!"\{
  \"plugin\": \"{c.plugin}\",
  \"model\": \"{m.model}\",
  \"toolchain\": \"{trim (← IO.FS.readFile (c.mitosRoot / "lean-toolchain"))}\",
  \"plugin_sha256\": \"{← sha256 src}\",
  \"models_lock_sha256\": \"{← sha256 m.lock}\",
  \"core_sha256\": \"{← sha256 coreCat}\",
  \"challenge_sha256\": \"{← sha256 chal}\",
  \"adequacy_challenge_sha256\": \"{← sha256 adequacyChal}\",
  \"paranoid\": {c.paranoid}
}
"
  IO.FS.createDirAll (c.workspace / "accepted")
  IO.FS.writeFile (c.workspace / "accepted" / s!"{c.plugin}.json") rec_
  IO.println s!"recorded {c.workspace / "accepted" / s!"{c.plugin}.json"}"

def runAccept (c : Config) : IO UInt32 := do
  let pluginFile := c.pluginFile.getD (c.workspace / "Plugins" / s!"{c.plugin}.lean")
  let gates : GateM (IO Unit) := do
    let m ← atGate 0 "provenance" (provenance c pluginFile)
    let src ← atGate 1 "lint" do
      let src ← IO.FS.readFile pluginFile
      lint c pluginFile src m
      pure src
    let chal := challenge c.plugin m.model
    let adequacyChal := adequacyChallenge m
    let (plugin, model) ← atGate 2 "sandbox build" (judge c m src chal adequacyChal)
    pluginGates c plugin
    adequacyGate m model
    return writeRecord c m src chal adequacyChal
  match ← gates.run with
  | .ok record =>
    if c.record then
      try record catch e =>
        IO.println s!"VERDICT: REJECTED (record: {e})"
        return 1
    IO.println "VERDICT: ACCEPTED"
    return 0
  | .error (g, name) =>
    IO.println s!"VERDICT: REJECTED (gate {g}: {name})"
    return 1

end MitosGate.Accept
