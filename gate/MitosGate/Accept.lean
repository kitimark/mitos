/-- The gate that rejects the plugin's run, or `none` when the run passes gates 2–5. -/
def pluginFailure : Outcome → Option GateId
  | .ok => none
  | .noJudgment | .importClash => some .sandbox
  | .missingConst | .statement => some .statements
  | .illegalAxiom => some .axioms
  | .kernelReject => some .kernels

/-- One comparator run: what it decided, and its output to show. -/
structure Judgment where
  outcome : Outcome
  output  : String

def runComparator (c : Config) (dir : System.FilePath) (config : String) : IO Judgment := do
  let args := #["comparator", s!"--config={config}"] ++ if c.paranoid then #["--paranoid"] else #[]
  try
    let (code, out) ← run "lake" args dir
    return { outcome := .parse code out, output := out }
  catch e => return { outcome := .noJudgment, output := s!"error: could not run lake comparator: {e}" }

/-- The regular files under `dir`, recursively, relative to it and sorted. Anything else there, such
as a symlink or a device, is an error: reading it could follow it out of the judging directory or
never end, and Lake writes only regular files. -/
partial def regularFiles (dir : System.FilePath) (rel : String := "") :
    ExceptT String IO (Array String) := do
  let mut out := #[]
  for e in ← dir.readDir do
    let r := if rel.isEmpty then e.fileName else rel ++ "/" ++ e.fileName
    match (← e.path.symlinkMetadata).type with
    | .dir => out := out ++ (← regularFiles e.path r)
    | .file => out := out.push r
    | _ => throw s!"{r} is neither a regular file nor a directory"
  return out.qsort (· < ·)

/-- The build outputs in the judging directory (`.lake/build/lib/lean/`) and the SHA-256 of each,
read by the gate process after a comparator run, when nothing in the sandbox is running. -/
def buildOutputs (dir : System.FilePath) : ExceptT String IO (Array (String × String)) := do
  let lib := dir / ".lake" / "build" / "lib" / "lean"
  if !(← lib.isDir) then return #[]
  let files ← regularFiles lib
  if files.isEmpty then return #[]
  let (code, out) ← run "sha256sum" (#["--"] ++ files) lib
  let lines := (out.splitOn "\n").filter (!·.isEmpty)
  unless code == 0 && lines.length == files.size do throw s!"sha256sum failed: {out}"
  return files.zip lines.toArray

/-- Every build output of `before` that `after` lacks or holds with other bytes. -/
def changedOutputs (before after : Array (String × String)) : Array String :=
  before.filterMap fun (f, h) => if after.contains (f, h) then none else some f

/-- Why gate 6's examples run failed, or `none` when it passed. -/
def examplesFailure (model : String) : Outcome → Option String
  | .ok => none
  | .missingConst => some s!"{examplesModule model} must declare `{model}.examples`"
  | .illegalAxiom =>
    some s!"`{model}.examples` uses an axiom outside {String.intercalate ", " permittedAxioms}"
  | .statement =>
    some s!"`{model}.examples` in {examplesModule model} is not a `Mitos.ModelExamples` definition"
  | .kernelReject => some s!"a kernel rejected {examplesModule model}"
  | .importClash | .noJudgment => some s!"{examplesModule model} could not be judged"

/-- Why gate 6's adequacy run failed, or `none` when it passed. -/
def adequacyFailure (model : String) : Outcome → Option String
  | .ok => none
  | .importClash =>
    some (s!"{adequacyModule model} does not build: two modules it imports declare one name; " ++
      s!"`{model}.examples` may be declared only in {examplesModule model}")
  | .missingConst =>
    some s!"{adequacyModule model} must declare `{model}.adequate`, and {modelModule model} `{model}`"
  | .illegalAxiom =>
    some s!"`{model}.adequate` uses an axiom outside {String.intercalate ", " permittedAxioms}"
  | .statement =>
    some s!"`{model}.adequate` does not state `Mitos.Model.Adequate {model} {model}.examples`"
  | .kernelReject => some s!"a kernel rejected `{model}.adequate`"
  | .noJudgment => some "the adequacy proof could not be judged"

/-- Gate 6, in order, each step only if the one before passed: the layout of the models
(`examplesLayout`), the examples module alone (`examples.json`), then the adequacy module
(`adequacy.json`). -/
def judgeModel (c : Config) (m : LockedModels) (dir : System.FilePath) :
    IO (Except (String × String) Unit) := do
  if let .error e := ← examplesLayout m then return .error (e, "")
  let ex ← runComparator c dir "examples.json"
  if let some why := examplesFailure m.model ex.outcome then return .error (why, ex.output)
  let ad ← runComparator c dir "adequacy.json"
  if let some why := adequacyFailure m.model ad.outcome then return .error (why, ad.output)
  return .ok ()

/-- The lines `showComparatorTail` prints for a comparator run's output: the last 15, without
progress lines and backtrace frames, each through `ciLine`. `gate/LintTest.lean` checks them on
hostile output. -/
def comparatorTail (out : String) : List String :=
  let frame (l : String) := l == "backtrace:" || (l.startsWith "/" && (l.splitOn " [0x").length > 1)
  let lines := (out.splitOn "\n").filter fun l =>
    !(l.startsWith "✔") && !(l.startsWith "Exporting") && !frame l
  (lines.reverse.take 15).reverse.map fun l => ciLine s!"  | {l}"

def showComparatorTail (out : String) : IO Unit := do
  for l in comparatorTail out do IO.println l

def pluginGates (c : Config) (j : Judgment) : GateM Unit := do
  if let some g := pluginFailure j.outcome then
    report g false
    showComparatorTail j.output
    throw (g, "")
  report .sandbox true
  report .statements true
  report .axioms true (String.intercalate ", " permittedAxioms)
  report .kernels true (if c.paranoid then "lean4lean, nanoda, con-leche, con-ron, paranoid" else "Lean kernel only (use --paranoid for independent kernels)")

/-- Gate 6's verdict. `j` is the layout and the two runs, with the reason and the comparator output
to show on failure. `rebuilt` says why gates 3 and 6 may not have judged one elaboration of the
model: the plugin's run changed or removed a build output of gate 6's runs, or the outputs could
not be compared. -/
def adequacyGate (m : LockedModels) (j : Except (String × String) Unit) (rebuilt : Option String) :
    GateM Unit := do
  if let .error (reason, out) := j then
    report .adequacy false reason
    unless out.isEmpty do showComparatorTail out
    throw (.adequacy, "")
  if let some why := rebuilt then
    report .adequacy false
      s!"gates 3 and 6 may not have judged one elaboration of the model: {why}"
    throw (.adequacy, "")
  report .adequacy true
    s!"{m.model}.adequate : Mitos.Model.Adequate {m.model} {m.model}.examples, examples from {examplesModule m.model}"

/-- One judging directory, so gates 3 and 6 see one elaboration of the model. Gate 6 is judged
first, before the plugin is built, so nothing the plugin's build writes can reach it. The plugin's
run must then reuse every output gate 6's run built: a module that runs code while it elaborates
could otherwise make Lake rebuild the model, and gate 3 would judge a different elaboration from
gate 6's. Writing and removing the directory is gate 2's; gate 6's runs and the hashing of their
outputs are gate 6's. Gates 2–5 are reported before gate 6. -/
def judge (c : Config) (i : Inputs) (chal adequacyChal : String) : GateM Unit := do
  let m := i.models
  let generated : List (System.FilePath × String) :=
    [ ("Plugins" / s!"{c.plugin}.lean", i.pluginSrc), ("Challenge" / s!"{c.plugin}.lean", chal),
      ("comparator.json", comparatorJson c.plugin),
      ("Challenge" / "Mitos" / "ModelAdequacy.lean", adequacyChal),
      ("examples.json", examplesComparatorJson m),
      ("adequacy.json", adequacyComparatorJson m),
      ("lakefile.toml", judgeLakefile), ("lake-manifest.json", judgeManifest) ]
  let paths (fs : Array (String × String)) : List (System.FilePath × String) :=
    fs.toList.map fun (r, t) => (⟨r⟩, t)
  let files := paths m.files ++ generated
  -- The core is written to `Mitos/`; every other file needs a path of its own.
  let rels := files.map (·.1.toString)
  let dir ← atGate .sandbox do
    if let some r := rels.find? fun r => r.startsWith "Mitos/" || (rels.filter (· == r)).length > 1 then
      throwThe IO.Error <| IO.userError s!"two files of the judging directory would share the path {r}"
    IO.FS.createTempDir
  let gates : GateM Unit := do
    atGate .sandbox do
      IO.FS.writeFile (dir / "lean-toolchain") i.toolchain
      for (rel, txt) in paths i.core ++ files do
        if let some p := (dir / rel).parent then IO.FS.createDirAll p
        IO.FS.writeFile (dir / rel) txt
    let model ← atGate .adequacy (judgeModel c m dir)
    let before ← atGate .adequacy (buildOutputs dir).run
    pluginGates c (← runComparator c dir "comparator.json")
    let after ← atGate .adequacy (buildOutputs dir).run
    -- An accepted gate 6 built the model module, so its `.olean` must be among the outputs;
    -- without it (another Lake layout, say) the comparison would check nothing.
    let modelOlean := "/".intercalate ((modelModule m.model).splitOn ".") ++ ".olean"
    let modelAccepted := match model with | .ok _ => true | .error _ => false
    let rebuilt := match before, after with
      | .ok b, .ok a =>
        let changed := changedOutputs b a
        if modelAccepted && !b.any (·.1 == modelOlean) then
          some s!"gate 6's runs left no {modelOlean} under .lake/build/lib/lean/ to compare"
        else if changed.isEmpty then none
        else some s!"the plugin's run changed {", ".intercalate (changed.toList.take 5)}"
      | .error e, _ | _, .error e => some e
    adequacyGate m model rebuilt
  -- The first failure decides the verdict: once a gate has failed, an error removing the
  -- directory is only reported.
  let ((), ()) ← tryFinally' gates fun passed? => do
    let close : IO Unit :=
      if c.keep then IO.println (ciLine s!"  (judging directory kept: {dir})")
      else IO.FS.removeDirAll dir
    if passed?.isSome then atGate .sandbox close
    else tryCatchThe IO.Error close fun e => report .sandbox false s!"I/O error: {e}"

/-- Write `text` to `file` by flushing `tmp` and renaming it over `file`, so a reader sees the old
file or the new one. `.writeNew` creates `tmp` or fails, and a failure of that open leaves the
path as it was: this run did not create it, so the catches do not remove it. A failure after the
open removes `tmp`. The flush raises a failed write here; `IO.FS.writeFile` leaves it to the
handle's finalizer, which drops it, and a short file would be renamed over `file`. Nothing fsyncs
before the rename. Lean v4.35 has no fsync primitive, so a machine crash can drop the new file. -/
def writeByRename (tmp file : System.FilePath) (text : String) : IO Unit := do
  IO.FS.withFile tmp .writeNew fun h => do
    try
      h.putStr text
      h.flush
    catch e =>
      try IO.FS.removeFile tmp catch _ => pure ()
      throw e
  try
    IO.FS.rename tmp file
  catch e =>
    try IO.FS.removeFile tmp catch _ => pure ()
    throw e

/-- The record of an accepted plugin, written to a file of its own in `accepted/` and renamed over
the old record, so a reader sees the old record or the new one, never part of one. `writeByRename`
does not fsync before the rename, so a machine crash can drop the new record. A SIGKILL between
the flush and the rename leaves `accepted/.<plugin>.json.<pid>.tmp`. That file is not the record,
and this run does not remove a temp file it did not create, so the leftover stays. -/
def writeRecord (c : Config) (i : Inputs) (chal adequacyChal : String) : IO Unit := do
  let mut coreCat := ""
  for (rel, txt) in i.core do coreCat := coreCat ++ rel ++ "\n" ++ txt
  let rec_ := s!"\{
  \"plugin\": \"{c.plugin}\",
  \"model\": \"{i.models.model}\",
  \"toolchain\": \"{trim i.toolchain}\",
  \"plugin_sha256\": \"{← sha256 i.pluginSrc}\",
  \"models_lock_sha256\": \"{← sha256 i.models.lock}\",
  \"core_sha256\": \"{← sha256 coreCat}\",
  \"challenge_sha256\": \"{← sha256 chal}\",
  \"adequacy_challenge_sha256\": \"{← sha256 adequacyChal}\",
  \"paranoid\": {c.paranoid}
}
"
  let dir := c.workspace / "accepted"
  let file := dir / s!"{c.plugin}.json"
  let tmp := dir / s!".{c.plugin}.json.{← IO.Process.getPID}.tmp"
  IO.FS.createDirAll dir
  -- The temp name carries this process's pid. A later run does not remove a leftover from a
  -- SIGKILL: its own temp path is different, and `writeByRename` removes a file only after this
  -- run has created it. A reused pid is the collision. `.writeNew` fails, the leftover stays,
  -- and the old record stays.
  writeByRename tmp file rec_
  IO.println (ciLine s!"recorded {file}")

def runAccept (c : Config) : IO UInt32 := do
  let pluginFile := c.pluginFile.getD (c.workspace / "Plugins" / s!"{c.plugin}.lean")
  let gates : GateM (IO Unit) := do
    let i ← atGate .provenance (provenance c pluginFile)
    atGate .lint (lint c pluginFile i)
    let chal := challenge c.plugin i.models.model
    let adequacyChal := adequacyChallenge i.models
    judge c i chal adequacyChal
    return writeRecord c i chal adequacyChal
  -- How the run ended: `.ok none`, `.ok (some e)` when the record could not be written, or the
  -- gate that rejected.
  let ended : Except (GateId × String) (Option String) ← match ← gates.run with
    | .ok record =>
      if c.record then
        try record; pure (.ok none)
        catch e => pure (.ok (some (toString e)))
      else pure (.ok none)
    | .error (g, why) => pure (.error (g, why))
  -- The verdict line is `Cheats.Verdict.render`'s, which the cheat runner reads back
  -- (`Cheats.Verdict.parse_eq_some_iff`). `Verdict.ofGate` writes its text with `ciLine`, so the
  -- line starts no workflow command and stays one line (`Cheats.Verdict.ofGate_not_startsCommand`,
  -- `Cheats.Verdict.ofGate_no_break`). It is printed as it is: `ciLine` would escape the `\` of an
  -- escape in it again.
  let v := Cheats.Verdict.ofGate ended
  IO.println v.render
  return v.exitCode

end MitosGate.Accept
