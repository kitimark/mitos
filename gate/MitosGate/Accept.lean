import MitosGate.Cheats
import MitosGate.GateId
import MitosGate.Lint
import MitosGate.Util

namespace MitosGate.Accept

structure Config where
  mitosRoot  : System.FilePath := "."
  workspace  : System.FilePath
  plugin     : String
  model      : String
  pluginFile : Option System.FilePath := none
  paranoid   : Bool := false
  skipLint   : Bool := false
  record     : Bool := false
  keep       : Bool := false

def permittedAxioms : List String := ["propext", "Quot.sound", "Classical.choice"]

def pluginImports : List String := ["Init", "Std", "Mitos.Core", "Models"]

def obligationNames (p : String) : List String :=
  [s!"{p}.anchored", s!"{p}.sound", s!"{p}.complete"]

def modelModule (model : String) : String :=
  String.intercalate "." ((model.splitOn ".").dropLast)

/-- The module that must declare `<model>.examples`: `Models.X.Examples` for `Models.X.model`. -/
def examplesModule (model : String) : String := modelModule model ++ ".Examples"

/-- The module that must prove `<model>.adequate`: `Models.X.Adequacy` for `Models.X.model`. -/
def adequacyModule (model : String) : String := modelModule model ++ ".Adequacy"

def moduleFile (mod : String) : String :=
  ((System.mkFilePath (mod.splitOn ".")).addExtension "lean").toString

/-- The models and `models.lock` exactly as gate 0 read and checked them. Only `provenance` builds
one, and every later gate and the record use these bytes instead of the workspace. -/
structure LockedModels where
  private mk ::
  model : String
  files : Array (String × String)
  lock  : String

/-- Everything the gate judges and records, as gate 0 read it. Only `provenance` builds one: the
judging directory, every later gate and the record use these bytes, so the record hashes what was
judged and nothing is read twice. -/
structure Inputs where
  private mk ::
  /-- Mitos's `lean-toolchain`, which the workspace's must match. -/
  toolchain : String
  /-- Every `.lean` file under `core/Mitos/`, by its path relative to `core/`, such as
  `Mitos/Core.lean`. -/
  core      : Array (String × String)
  models    : LockedModels
  pluginSrc : String

/-- The core's files by their paths relative to `core/`: their paths in the judging directory,
however `--mitos-root` is spelled. -/
def coreFiles (mitosRoot : System.FilePath) : IO (Array (String × String)) := do
  let core := mitosRoot / "core"
  (← leanFiles (core / "Mitos")).mapM fun f => do
    return ((f.toString.drop (core.toString.length + 1)).toString, ← IO.FS.readFile f)

def challenge (p model : String) : String :=
  s!"import Mitos.Core
import {modelModule model}

/-! Generated by mitos-gate. Do not edit: the statements here are what acceptance means. -/

-- Every name starts from `_root_`, the declared ones too. `theorem {p}.sound` would open
-- namespace `{p}` while elaborating its type, and Lean would look `_root_.Mitos.SoundWrt` up as
-- `{p}._root_.Mitos.SoundWrt` and `Mitos.SoundWrt` as `{p}.Mitos.SoundWrt` first, so a model
-- module that declared either would change what the Challenge states.
def _root_.{p}.extractor : _root_.Mitos.Extractor := sorry
theorem _root_.{p}.anchored : _root_.Mitos.Anchored _root_.{p}.extractor := sorry
theorem _root_.{p}.sound : _root_.Mitos.SoundWrt _root_.{model} _root_.{p}.extractor := sorry
theorem _root_.{p}.complete : _root_.Mitos.CompleteWrt _root_.{model} _root_.{p}.extractor := sorry
"

def quote (s : String) : String := "\"" ++ s ++ "\""

def comparatorJson (p : String) : String :=
  let thms := String.intercalate ", " ((obligationNames p).map quote)
  let axs := String.intercalate ", " (permittedAxioms.map quote)
  s!"\{\"challenge_module\": \"Challenge.{p}\", \"solution_module\": \"Plugins.{p}\",
 \"theorem_names\": [{thms}],
 \"definition_names\": [\"{p}.extractor\"],
 \"permitted_axioms\": [{axs}]}
"

def adequacyChallenge (m : LockedModels) : String :=
  s!"import Mitos.Core

/-! Generated by mitos-gate (gate 6). Do not edit: the statement here is what model adequacy means. -/

def _root_.{m.model} : _root_.Mitos.Model := sorry
def _root_.{m.model}.examples : _root_.Mitos.ModelExamples := sorry
theorem _root_.{m.model}.adequate :
    _root_.Mitos.Model.Adequate _root_.{m.model} _root_.{m.model}.examples := sorry
"

/-- Gate 6's Challenge module. A plugin name is a plain identifier, so `Challenge.{p}` is never
this module and `Challenge/{p}.lean` never its file. -/
def adequacyChallengeModule : String := "Challenge.Mitos.ModelAdequacy"

/-- A comparator configuration against gate 6's Challenge. -/
def gate6ComparatorJson (solution : String) (theorems definitions : List String) : String :=
  let axs := String.intercalate ", " (permittedAxioms.map quote)
  let names (xs : List String) := String.intercalate ", " (xs.map quote)
  s!"\{\"challenge_module\": \"{adequacyChallengeModule}\", \"solution_module\": \"{solution}\",
 \"theorem_names\": [{names theorems}],
 \"definition_names\": [{names definitions}],
 \"permitted_axioms\": [{axs}]}
"

/-- Gate 6's first run: the examples module on its own declares `<model>.examples`, a
`Mitos.ModelExamples`. -/
def examplesComparatorJson (m : LockedModels) : String :=
  gate6ComparatorJson (examplesModule m.model) [] [s!"{m.model}.examples"]

/-- Gate 6's second run: the adequacy module proves `<model>.adequate` of the model and the examples
it imports. -/
def adequacyComparatorJson (m : LockedModels) : String :=
  gate6ComparatorJson (adequacyModule m.model) [s!"{m.model}.adequate"]
    [m.model, s!"{m.model}.examples"]

/-- The modules a source file's header imports, as Lean's own parser reads them. -/
def headerImports (src : String) : IO (Except String (Array Lean.Name)) := do
  let (imports, _, msgs) ← Lean.Elab.parseImports src
  if msgs.hasErrors then return .error "its header does not parse"
  return .ok (imports.map (·.module))

def underAny (prefixes : List Lean.Name) (n : Lean.Name) : Bool :=
  prefixes.any (·.isPrefixOf n)

/-- Gate 6's check, on the locked headers, that the golden facts and the model share no
definition outside `Mitos.Core`. For `Models.X.model`:
- every import's components are plain identifiers (`Lint.plainComponents`). Lean finds a module's
  file by joining its name's components with `/`, so a component such as `«..»` or `«X/Examples»`
  would name a file outside the locked models, or the examples module's file, under another name;
- the examples module `Models.X.Examples` imports only `Mitos.Core` (and `Init`);
- the adequacy module `Models.X.Adequacy` imports `Models.X` and `Models.X.Examples`;
- no other model module imports the examples module, and none imports the adequacy module, so the
  model module cannot reach anything the examples module declares;
- model modules import only `Init`, `Std`, `Mitos.Core` and `Models` modules, so every import path
  stays in the locked files.

The examples run then checks that the examples module declares `<model>.examples`. Since the
adequacy module imports it, no other module can declare that name for the adequacy run. -/
def examplesLayout (m : LockedModels) : IO (Except String Unit) := do
  let model := modelModule m.model
  let ex := examplesModule m.model
  let adq := adequacyModule m.model
  let mut headers : Array (String × Array Lean.Name) := #[]
  for (rel, txt) in m.files do
    match ← headerImports txt with
    | .error e => return .error s!"{rel}: {e}"
    | .ok imports => headers := headers.push (rel, imports)
  for (rel, imports) in headers do
    for n in imports do
      if (Lint.plainComponents n).isNone then
        return .error s!"{rel} imports {n}; each component of a module name must be a plain identifier"
  let importsOf (mod : String) := (headers.find? (·.1 == moduleFile mod)).map (·.2)
  let some exImports := importsOf ex
    | return .error s!"the examples must be in their own module {ex} ({moduleFile ex})"
  let some adqImports := importsOf adq
    | return .error s!"the adequacy proof must be in its own module {adq} ({moduleFile adq})"
  for n in exImports do
    unless underAny [`Init, `Mitos.Core] n do
      return .error s!"{ex} imports {n}; the examples module may import only Mitos.Core"
  unless adqImports.contains model.toName && adqImports.contains ex.toName do
    return .error s!"{adq} must import {model} and {ex}"
  for (rel, imports) in headers do
    for n in imports do
      unless underAny [`Init, `Std, `Mitos.Core, `Models] n do
        return .error s!"{rel} imports {n}; model modules may import only Init, Std, Mitos.Core and Models"
      if n == ex.toName && rel != moduleFile adq then
        return .error s!"{rel} imports {ex}; only {adq} may, so the model cannot reach the examples"
      if n == adq.toName then
        return .error s!"{rel} imports {adq}; no model module may"
  return .ok ()

def judgeLakefile : String :=
  "name = \"judge\"\n[[lean_lib]]\nname = \"Judge\"\n" ++
  "globs = [\"Mitos.Core\", \"Mitos.Core.+\", \"Models.+\", \"Plugins.+\", \"Challenge.+\"]\n"

def judgeManifest : String :=
  "{\"version\": \"1.3.0\", \"packagesDir\": \".lake/packages\", \"packages\": [], " ++
  "\"name\": \"judge\", \"lakeDir\": \".lake\", \"fixedToolchain\": false}\n"

def report (g : GateId) (ok : Bool) (detail : String := "") : IO Unit := do
  let status := if ok then "PASS" else "FAIL"
  IO.println (ciLine s!"{g.label}: {status}{if detail.isEmpty then "" else " — " ++ detail}")

private def validIdent (s : String) : Bool :=
  !s.isEmpty && s.toList.all (fun c => c.isAlphanum || c == '_') && (s.toList.head!).isAlpha

/-- A rejection is the gate that failed and what failed in it when that was not the gate's own
judgment (`I/O error`), otherwise `""`. -/
abbrev GateM := ExceptT (GateId × String) IO

/-- `x` as part of gate `g`: an I/O error in it fails `g`. -/
def atGate (g : GateId) (x : GateM α) : GateM α :=
  tryCatchThe IO.Error x fun e => do
    report g false s!"I/O error: {e}"
    throw (g, "I/O error")

/-! ## `models.lock` -/

/-- A workspace's model files: every `.lean` file under `Models/`, recursively, with its path
relative to the workspace and its text, sorted by path. Gate 0 reads the models with it, and
`mitos-gate lock-models` locks them. -/
def modelFiles (workspace : System.FilePath) : IO (Array (String × String)) := do
  (← leanFiles (workspace / "Models")).mapM fun f =>
    return ((f.toString.drop (workspace.toString.length + 1)).toString, ← IO.FS.readFile f)

/-- Whether `h` is a SHA-256 as `sha256sum` prints it: 64 lower-case hexadecimal digits.
`sha256sum --check` also accepts upper case; gate 0 does not. -/
def isSha256 (h : List Char) : Bool :=
  h.length == 64 && h.all fun c => c.isDigit || ('a' ≤ c && c ≤ 'f')

example : isSha256 "D50E5AC2F941C654A7141D3E5BBC1631E1547F442CF3027E6C597E238CEC21BB".toList = false := by
  decide +kernel

/-- `models.lock` for the model files `es`, each a path and its SHA-256, as `sha256sum` prints
them: the SHA-256, two spaces and the path, one file per line. -/
def renderLock (es : List (String × String)) : String :=
  String.join (es.map fun (path, h) => h ++ "  " ++ path ++ "\n")

/-- A line of `models.lock`, as its path and SHA-256: the SHA-256, two spaces, and the rest of the
line is the path, which holds no two spaces in a row. -/
def lockLine (l : List Char) : Except String (String × String) :=
  let malformed : Except String (String × String) :=
    .error s!"models.lock has a malformed line: {String.ofList l}"
  match l.splitAt 64 with
  | (h, ' ' :: ' ' :: path) =>
    if isSha256 h ∧ ¬[' ', ' '] <:+: path then .ok (String.ofList path, String.ofList h)
    else malformed
  | _ => malformed

/-- A path the list holds twice, if there is one. -/
def listedTwice : List String → Option String
  | [] => none
  | p :: ps => if ps.contains p then some p else listedTwice ps

/-- Gate 0's reading of `models.lock`: each line that is not empty, as its path and SHA-256. -/
def lockEntries (lock : String) : Except String (List (String × String)) := do
  let entries ← ((lock.toList.splitOn '\n').filter (!·.isEmpty)).mapM lockLine
  if let some p := listedTwice (entries.map (·.1)) then throw s!"models.lock lists {p} twice"
  return entries

theorem listedTwice_eq_none {ps : List String} : listedTwice ps = none ↔ ps.Nodup := by
  induction ps with
  | nil => simp [listedTwice]
  | cons p ps ih => by_cases h : p ∈ ps <;> simp [listedTwice, h, ih]

/-- A lock that gate 0 reads lists no path twice, so `List.lookup` finds a path's only line. -/
theorem lockEntries_nodup {lock : String} {es : List (String × String)}
    (h : lockEntries lock = .ok es) : (es.map (·.1)).Nodup := by
  simp only [lockEntries, bind, Except.bind] at h
  split at h
  · cases h
  · split at h
    · cases h
    · rename_i twice
      cases h
      exact listedTwice_eq_none.mp (Option.eq_none_iff_forall_ne_some.mpr twice)

/-- Gate 0 reads back exactly what `mitos-gate lock-models` writes: model files with distinct
paths that hold no line break and no two spaces in a row, each with its SHA-256 as `sha256sum`
prints it. -/
theorem lockEntries_renderLock {es : List (String × String)}
    (hashes : ∀ e ∈ es, isSha256 e.2.toList) (paths : ∀ e ∈ es, '\n' ∉ e.1.toList)
    (spaces : ∀ e ∈ es, ¬[' ', ' '] <:+: e.1.toList)
    (distinct : (es.map (·.1)).Nodup) : lockEntries (renderLock es) = .ok es := by
  let line (e : String × String) := e.2.toList ++ ' ' :: ' ' :: e.1.toList
  have lines : ∀ es : List (String × String), (∀ e ∈ es, isSha256 e.2.toList) →
      (∀ e ∈ es, '\n' ∉ e.1.toList) →
      (renderLock es).toList.splitOn '\n' = es.map line ++ [[]] := by
    intro es hs ps
    induction es with
    | nil => rfl
    | cons e es ih =>
      have hx : '\n' ∉ line e := by
        have := hs e (by simp)
        simp only [isSha256, Bool.and_eq_true, beq_iff_eq, List.all_eq_true] at this
        simp only [line, List.mem_append, List.mem_cons, not_or]
        exact ⟨fun m => absurd (this.2 _ m) (by decide), by decide, by decide, ps e (by simp)⟩
      have : (renderLock (e :: es)).toList = line e ++ '\n' :: (renderLock es).toList := by
        simp [renderLock, line]
      rw [this, List.splitOn_append_cons_self_of_not_mem hx,
        ih (fun e m => hs e (by simp [m])) (fun e m => ps e (by simp [m]))]
      rfl
  have parsed : ∀ es : List (String × String), (∀ e ∈ es, isSha256 e.2.toList) →
      (∀ e ∈ es, ¬[' ', ' '] <:+: e.1.toList) → (es.map line).mapM lockLine = .ok es := by
    intro es hs ss
    induction es with
    | nil => rfl
    | cons e es ih =>
      have he := hs e (by simp)
      have len : e.2.toList.length = 64 := by
        simp only [isSha256, Bool.and_eq_true, beq_iff_eq] at he; exact he.1
      have : lockLine (line e) = .ok e := by
        simp [lockLine, line, List.splitAt_eq, len, he, ss e (by simp)]
      simp [List.mapM_cons, this, ih (fun e m => hs e (by simp [m])) (fun e m => ss e (by simp [m]))]
      rfl
  have kept : (es.map line).filter (!·.isEmpty) = es.map line := by
    rw [List.filter_eq_self]
    intro l m
    simp only [List.mem_map] at m
    obtain ⟨e, -, rfl⟩ := m
    simp [line]
  simp only [lockEntries, lines es hashes paths, List.filter_append]
  simp [kept, parsed es hashes spaces, bind, Except.bind, listedTwice_eq_none.mpr distinct]
  rfl

def provenance (c : Config) (pluginFile : System.FilePath) : GateM Inputs := do
  let mut errs := #[]
  unless validIdent c.plugin do errs := errs.push s!"plugin name `{c.plugin}` is not a plain identifier"
  let parts := c.model.splitOn "."
  unless parts.length ≥ 3 && parts.head? == some "Models" && parts.all validIdent do
    errs := errs.push s!"model `{c.model}` is not a dotted identifier in Models, such as Models.Name.model"
  let wsTc := c.workspace / "lean-toolchain"
  let tc ← IO.FS.readFile (c.mitosRoot / "lean-toolchain")
  if !(← wsTc.pathExists) then errs := errs.push "workspace has no lean-toolchain"
  else if trim (← IO.FS.readFile wsTc) != trim tc then
    errs := errs.push s!"workspace toolchain differs from Mitos pin {trim tc}"
  let core ← coreFiles c.mitosRoot
  let mut pluginSrc := ""
  if ← pluginFile.pathExists then pluginSrc ← IO.FS.readFile pluginFile
  else errs := errs.push s!"plugin file {pluginFile} not found"
  let files ← modelFiles c.workspace
  let modelFile := ((System.mkFilePath parts.dropLast).addExtension "lean").toString
  unless files.any (·.1 == modelFile) do
    errs := errs.push s!"model module file {c.workspace / modelFile} not found"
  let lockFile := c.workspace / "models.lock"
  let lock ← if ← lockFile.pathExists then IO.FS.readFile lockFile else pure ""
  if lock.isEmpty then errs := errs.push "workspace has no models.lock"
  else match lockEntries lock with
    | .error e => errs := errs.push e
    | .ok listed =>
      for (rel, txt) in files do
        match List.lookup rel listed with
        | none => errs := errs.push s!"model {rel} is not in models.lock"
        | some h => unless h == (← sha256 txt) do
            errs := errs.push s!"models.lock does not match the models: {rel}: FAILED"
      for (path, _) in listed do
        unless files.any (·.1 == path) do
          errs := errs.push s!"models.lock lists {path}, which is not a model file"
  report .provenance errs.isEmpty (String.intercalate "; " errs.toList)
  unless errs.isEmpty do throw (.provenance, "")
  return { toolchain := tc, core, models := { model := c.model, files, lock }, pluginSrc }

def lint (c : Config) (pluginFile : System.FilePath) (i : Inputs) : GateM Unit := do
  if c.skipLint then
    IO.println s!"{GateId.lint.label}: SKIPPED (--skip-lint: measuring the later gates only)"
    return
  let env ← Lint.syntaxEnv
  let mut shown := #[]
  for v in ← Lint.check env pluginImports i.pluginSrc do shown := shown.push (v.render pluginFile.toString)
  for (rel, txt) in i.models.files do
    for v in ← Lint.checkModel env pluginImports txt do
      shown := shown.push (v.render (c.workspace / rel).toString)
  report .lint shown.isEmpty s!"{shown.size} violation(s)"
  for v in shown do IO.println (ciLine s!"  {v}")
  unless shown.isEmpty do throw (.lint, "")

/-! ## What a comparator run decided -/

/-- What one `lake comparator` run decided. `Outcome.parse` reads it from the run's exit code and
output, and nothing else in the gate decides anything from comparator text. Gates 2–5
(`pluginFailure`) and both runs of gate 6 (`examplesFailure`, `adequacyFailure`) match every
constructor. -/
inductive Outcome
  /-- Exit code 0 and `Your solution is okay!`: everything built, the statements and definition holes
  match the Challenge's, only permitted axioms are used, and every kernel accepts. -/
  | ok
  /-- A theorem or definition uses an axiom outside the permitted ones. -/
  | illegalAxiom
  /-- A constant the configuration names is missing from the solution. -/
  | missingConst
  /-- A statement or definition hole differs from the Challenge's. -/
  | statement
  /-- A kernel rejected the solution. -/
  | kernelReject
  /-- A module did not build because two modules it imports declare one name. -/
  | importClash
  /-- No judgment: any other build error, or the comparator did not run. -/
  | noJudgment
  deriving DecidableEq

/-- Whether `pat` occurs in `s` as consecutive characters. On lists, because `decide` cannot
evaluate `String.splitOn` in the examples below. -/
def occursIn (pat : List Char) : List Char → Bool
  | [] => pat.isEmpty
  | s@(_ :: rest) => pat.isPrefixOf s || occursIn pat rest

/-- The comparator's messages for a constant the solution lacks: the exporter's panic and
`Lake.Check.compareAt`'s own. -/
def missingMarkers : List String := ["not found in environment", "Const not found in solution"]

/-- `Lake.Check.compareAt`'s messages for a statement or definition hole that is not the
Challenge's. -/
def statementMarkers : List String :=
  [ "Const not found in challenge",
    "Const does not match between challenge and target",
    "Challenge and solution constant kind don't match",
    "Challenge and solution theorem statement do not match",
    "Challenge constant is not a definition", "Solution constant is not a definition" ]

/-- The outcome of a comparator run that exited with `code` and printed `out`. The comparator stops
at its first error, but the build output before it is the plugin's and the models', and can hold
any of these markers. So the order of the checks decides which gate such a run fails, never whether
it is accepted: that needs exit code 0 (`Outcome.parse_ok`). -/
def Outcome.parse (code : UInt32) (out : String) : Outcome :=
  let has (marker : String) := occursIn marker.toList out.toList
  if code == 0 && has "Your solution is okay!" then .ok
  else if has "Illegal axiom" then .illegalAxiom
  else if missingMarkers.any has then .missingConst
  else if statementMarkers.any has then .statement
  else if has "kernel" && has "reject" then .kernelReject
  else if has "environment already contains" then .importClash
  else .noJudgment

/-- Only a run that exited with code 0 is `ok`. -/
theorem Outcome.parse_ok {code : UInt32} {out : String} (h : Outcome.parse code out = .ok) :
    code = 0 := by
  simp only [Outcome.parse] at h
  split at h
  · simp_all
  · repeat' split at h
    all_goals simp_all

/-! Each outcome, from the last lines of a real run as the gate prints them, without its `  | `
prefix. Unless its comment says otherwise, the text is from the named log in CI's `cheat-logs`
artifact for main at c79e03f. The exit codes are the ones Lake's `CLI/Check.lean` returns: 0 for an
accepted run, 1 for any error once the run has started. -/

-- The `cd core && lake comparator --paranoid` step of the same CI run: the gate prints no
-- comparator output for an accepted run.
example : Outcome.parse 0 "Running con-ron kernel on solution
con-ron: accepted 1885 declarations (--verified)
con-ron kernel accepts the solution
Running Lean default kernel on solution
Lean default kernel accepts the solution
Your solution is okay!
" = .ok := by decide +kernel

