why=A bug the theorems catch (src_dst_swapped) claimed as a known gap: the proof repair makes Mitos/Proofs/Resolve/Basic.lean declare a correct resolver of its own instead of importing Mitos.Impl.Resolve, so the gate's run accepts proofs about that one and the bug would read as a gap.
survives=none: the proofs are about the proof module's own resolver, not the mutant's.
rejects=values
file=Mitos/Impl/Resolve.lean
find=requiringRepo := r.repo, providingRepo := p.repo
replace=requiringRepo := p.repo, providingRepo := r.repo
file=Mitos/Proofs/Resolve/Basic.lean
find=import Mitos.Impl.Resolve
replace=import Mitos.Core namespace Mitos.Impl def providers (fs : List Located) (r : Located) : List Located := fs.filter (matchesB r) def boundProviders (fs : List Located) (r b : Located) : List Located := match b.fact.kind with | .binds _ => fs.filter (boundB r b) | _ => [] def ends (fs : List Located) (r : Located) : List Located := providers fs r ++ fs.flatMap (boundProviders fs r) abbrev EndSummary := Option (Option Nat) def summarizeEnds (ps : List Located) : EndSummary := match ps with | [] => none | p :: rest => if rest.all (·.id == p.id) then some (some p.id) else some none def EndSummary.accepts (s : EndSummary) (id : Nat) : Bool := match s with | none => true | some (some candidate) => candidate == id | some none => false def assumptionsOf (r p : Located) : List Assumption := if r.origin = p.origin then [r.origin] else [r.origin, p.origin] def assumptionsVia (r b p : Located) : List Assumption := (assumptionsOf r p).insert b.origin def statusOf (fs : List Located) (r p : Located) (assumes : List Assumption) (same : Bool := (ends fs r).all (·.id == p.id)) : Status := if assumes.all (fun a => !a.isAI) && same then .confirmed else .inferred def mkEdge (fs : List Located) (r p : Located) (same : Bool := (ends fs r).all (·.id == p.id)) : Edge := { requiringRepo := r.repo, providingRepo := p.repo, ident := r.fact.ident, scope := r.fact.scope, key := .direct r.id p.id, assumes := assumptionsOf r p, status := statusOf fs r p (assumptionsOf r p) same } def mkBoundEdge (fs : List Located) (r b p : Located) (same : Bool := (ends fs r).all (·.id == p.id)) : Edge := { mkEdge fs r p same with key := .bound r.id b.id p.id, through := [b.repo], assumes := assumptionsVia r b p, status := statusOf fs r p (assumptionsVia r b p) same } def isRequirement (l : Located) : Bool := l.fact.kind == .requires def resolveOne (fs : List Located) (r : Located) : List Edge × List Nat := let direct := providers fs r; let groups := fs.map fun b => (b, boundProviders fs r b); let allEnds := direct ++ groups.flatMap Prod.snd; let summary := summarizeEnds allEnds; (direct.map (fun p => mkEdge fs r p (summary.accepts p.id)) ++ groups.flatMap (fun (b, ps) => ps.map fun p => mkBoundEdge fs r b p (summary.accepts p.id)), if isRequirement r && allEnds.isEmpty then [r.id] else []) def resolve : Resolver := fun fs => let rows := fs.map (resolveOne fs); { edges := rows.flatMap Prod.fst, unresolved := rows.flatMap Prod.snd } end Mitos.Impl
