import MitosGate.Land
import MitosGate.Util
import MitosGate.Speech
import MitosGate.Snapshot.Fields
import MitosGate.Watch.Time

/-! UNCHECKED SKETCH (#502). Who spoke in a post from the owner's login, and which of the owner's
words no agent has answered yet.

GitHub names the app behind an issue comment in `performed_via_github_app`, and the owner's own
typed comment names none. The review routes (review comments, reviews) carry no such key at all
(checked live), so there the route cannot tell typed words from an agent's reply. The footer is
text anyone can type, so it never decides who spoke in an issue comment (#501).

Two readers use this file, under different rules on purpose:
* The watcher (`Wake.quiet`) hides a post only for the consumer whose app made it, or when that
  consumer's class recorded its id. Typed words are never hidden, and the watcher never reads the
  footer.
* `pr-state.sh` asks `mitos-gate watch unanswered` which owner words still wait for an answer.
  There a post is classified as `land` classifies it (`Snapshot.speaks` and `Snapshot.answers` in
  `Snapshot/Fields.lean`), with one change, #501: typed words are words even when they end with a
  footer, and they never answer. `SpeaksAsLandUnlessTyped` and `AnswersAsLandUnlessTyped` tie the
  two rules, so gate/ holds one classifier with one stated exception, not two that disagree. Land
  keeps the footer rule for typed words until the owner answers question 8b (PR 3c).

Timing and counting stay those of `pr-state.sh`'s jq, not land's: a post's time is `created_at`
(`submitted_at` for a review), a review counts only when it approves, requests changes or has a
body, and words are unanswered when newer than every answer in their thread. Land times words by
`max created updated`, joins a review comment to its review, and exempts `/land`-only lines. That
difference predates this work, and PR 3's body lists it.

Against `pr-state.sh`'s jq as it is on `main` today, these classes change. Each has a fixture
below and a case in `gate/watch-fixtures/posts-336/`, and PR 3a and PR 3 list them:
1. Typed words that end with a footer: jq calls them an answer; here they are words (#501).
2. A post through an answer app (`answerApps`, the slugs of `Speech.apps`: `claude`, `cursor`)
   without a footer: jq calls it words; here it is an answer.
3. A post through another app (Codex) without a footer: jq calls it words; here it is neither.
4. The footer test is `Speech.footer`, as land's: the last non-blank line starts with
   `_Generated by`. jq matches Claude's exact footer at the end of the body. So a quoted footer as
   the last line is no footer here, and another tool's `_Generated by` line is one.
Unchanged: a post through another app with a footer answers, as in jq and land, and the review
routes are decided by the footer, as in jq and land. PR 3a moves jq to classes 1 to 3, so PR 3
changes only class 4. Layout copies `Speech/Comment.lean`. -/

namespace MitosGate.Watch

open Land (Pr)

inductive Place
  | issueComment
  | reviewComment
  | review
  deriving DecidableEq, Repr

/-- What a route says about the app. `absent`: the route has no such key (the review routes).
`none`: the key is there and null. -/
inductive Via
  | absent
  | none
  | app (slug : String)
  deriving DecidableEq, Repr

inductive Speaker
  | typed
  | app (slug : String)
  | untold
  deriving DecidableEq, Repr

/-- A post as a route gives it, body and all. Only `pr-state`'s `unanswered` reads the body. -/
structure Said where
  place : Place
  id : Nat
  thread : Pr
  login : String
  via : Via
  created : Epoch
  updated : Epoch
  state : Option String
  body : String
  deriving Repr

def Said.speaker (p : Said) : Speaker :=
  match p.place, p.via with
  | .issueComment, .none => .typed
  | _, .app s => .app s
  | _, _ => .untold

/-- The slug as land's `Snapshot.Post.slug` holds it. -/
def Said.slug (p : Said) : Option String :=
  match p.via with
  | .app s => some s
  | _ => none

/-- One printable line. The proof travels with the text, so a body cannot start a line of its own
or hide behind an invisible character, even when read back from a state file (`Excerpt.ofStored?`
checks again). -/
structure Excerpt where
  text : String
  ok : ∀ c ∈ text.toList, printable c = true ∨ c = '\\'

instance : DecidableEq Excerpt := fun a b =>
  if h : a.text = b.text then isTrue (by cases a; cases b; simp_all) else isFalse (by
    intro e; cases e; exact h rfl)

/-- Whitespace runs become one space. -/
def squeezeGo : List Char → Bool → List Char
  | [], _ => []
  | c :: cs, gap =>
    if c.isWhitespace then (if gap then squeezeGo cs true else ' ' :: squeezeGo cs true)
    else c :: squeezeGo cs false

/-- Whitespace runs become one space, then at most `n` characters. -/
def squeeze (n : Nat) (b : String) : String := String.ofList ((squeezeGo b.toList true).take n)

def Excerpt.of (b : String) : Excerpt := ⟨oneLine (squeeze 120 b), oneLine_printable _⟩

def Excerpt.ofStored? (s : String) : Option Excerpt :=
  if h : ∀ c ∈ s.toList, printable c = true ∨ c = '\\' then some ⟨s, h⟩ else none

/-- The watcher's form of a post: no body, an excerpt. -/
structure Post where
  place : Place
  id : Nat
  thread : Pr
  speaker : Speaker
  created : Epoch
  updated : Epoch
  state : Option String
  excerpt : Excerpt
  deriving DecidableEq

def Post.of (p : Said) : Post :=
  ⟨p.place, p.id, p.thread, p.speaker, p.created, p.updated, p.state, Excerpt.of p.body⟩

def Post.edited (p : Post) : Bool := p.created != p.updated

/-! `pr-state`'s question. -/

/-- The apps whose posts answer without a footer: the slugs land's `answers` accepts. Changing it
is the root's default 8c, which the owner may refuse on PR 0. -/
def answerApps : List String := Speech.apps.map (·.1)

def footer (p : Said) : Bool := Speech.footer p.body.toList

/-- A review counts only when it approves, requests changes or has a body, as in jq and
`Snapshot.counts`. The shared poll uses it too, so an empty `COMMENTED` review wrapper is no post. -/
def counts (p : Said) : Bool :=
  match p.place with
  | .review => p.state == some "APPROVED" || p.state == some "CHANGES_REQUESTED" || p.body != ""
  | _ => true

def words (p : Said) : Bool :=
  match p.speaker with
  | .typed => true
  | _ => p.slug.isNone && !footer p

def answer (apps : List String) (p : Said) : Bool :=
  match p.speaker with
  | .typed => false
  | _ => p.slug.any (apps.contains ·) || footer p

/-- Insertion sort, which reduces under `decide` (`List.mergeSort` does not). -/
def insertId (x : Nat) : List Nat → List Nat
  | [] => [x]
  | y :: ys => if y < x then y :: insertId x ys else x :: y :: ys

def sortIds : List Nat → List Nat
  | [] => []
  | x :: xs => insertId x (sortIds xs)

/-- The ids of the owner's words in `thread` that are newer than every answer there. -/
def unansweredIn (owner : String) (apps : List String) (posts : List Said) (thread : Pr) :
    List Nat :=
  let mine := posts.filter fun p => p.login == owner && p.thread == thread && counts p
  let answers := mine.filter (answer apps)
  let newer (p : Said) := answers.all fun q => q.created < p.created
  sortIds ((mine.filter fun p => words p && newer p).map (·.id)).eraseDups

/-- Every thread with unanswered words, each once, in the order first seen. -/
def unanswered (owner : String) (apps : List String) (posts : List Said) : List (Pr × List Nat) :=
  let threads := (posts.map (·.thread)).eraseDups
  threads.filterMap fun t =>
    match unansweredIn owner apps posts t with
    | [] => none
    | ids => some (t, ids)

def TypedOnlyFromAnIssueCommentWithNoApp : Prop :=
  ∀ p : Said, p.speaker = .typed ↔ (p.place = .issueComment ∧ p.via = .none)

def ReviewRoutesAreNeverTyped : Prop :=
  ∀ p : Said, p.place ≠ .issueComment → p.speaker ≠ .typed

def TypedIsAlwaysWords : Prop :=
  ∀ (apps : List String) (p : Said), p.speaker = .typed → words p = true ∧ answer apps p = false

/-- A post through any app is never the owner's words, and one through an app outside `apps`
answers only by its footer, as in land. -/
def AnAppPostIsNeverWords : Prop :=
  ∀ (apps : List String) (p : Said) s, p.speaker = .app s →
    words p = false ∧ (s ∉ apps → answer apps p = footer p)

/-- Land's rule, except for typed words. `l` is land's form of the same post. Short: unfold, then
cases on the place and the app key. -/
def SpeaksAsLandUnlessTyped : Prop :=
  ∀ (g : Snapshot.Global) (p : Said) (l : Snapshot.Post), p.speaker ≠ .typed →
    l.login = g.owner → l.slug = p.slug → l.body = p.body → words p = Snapshot.speaks g l

/-- Short, with `(Speech.apps.lookup x).isSome = answerApps.contains x`. -/
def AnswersAsLandUnlessTyped : Prop :=
  ∀ (g : Snapshot.Global) (p : Said) (l : Snapshot.Post), p.speaker ≠ .typed →
    l.login = g.owner → l.slug = p.slug → l.body = p.body →
    answer answerApps p = Snapshot.answers g l

/-- Moderate: a filter, `eraseDups` and the sort keep membership. -/
def TypedWordsAreListedUntilAnswered : Prop :=
  ∀ (owner : String) (apps : List String) (posts : List Said) (p : Said), p ∈ posts →
    p.login = owner → p.speaker = .typed →
    (∀ q ∈ posts, q.login = owner → q.thread = p.thread → counts q = true → answer apps q = true →
      q.created < p.created) →
    p.id ∈ unansweredIn owner apps posts p.thread

/-- Every character is printable or the escape backslash, so no newline, carriage return, line or
paragraph separator, NEL or escape can reach a line. -/
def ExcerptIsOneLine : Prop :=
  ∀ b : String, ∀ c ∈ (Excerpt.of b).text.toList, printable c = true ∨ c = '\\'

namespace Fixture

def footerText : String := "\n\n---\n_Generated by [Claude Code](https://claude.ai/code)_\n"

/-- The owner quotes an agent's post, footer and all, in a comment typed on GitHub (#501). -/
def ownerQuotesAFooter : Said :=
  { place := .issueComment, id := 11, thread := 501, login := "o", via := .none, created := 10,
    updated := 10, state := none, body := "> it is done" ++ footerText }

/-- A Codex catch-up from the owner's login, through Codex's app, with the footer (#336). -/
def codexCatchUp : Said :=
  { place := .issueComment, id := 12, thread := 336, login := "o",
    via := .app "chatgpt-codex-connector", created := 20, updated := 20, state := none,
    body := "## Catch-up: review the fix" ++ footerText }

/-- The same without the footer: jq calls it owner words; here it is neither (class 3). -/
def codexBare : Said := { codexCatchUp with id := 14, body := "## Catch-up: review the fix" }

/-- A Claude-app post that lost its footer: jq calls it words; here it answers (class 2). -/
def claudeBare : Said :=
  { codexCatchUp with id := 15, via := .app "claude", body := "Fixed in abc1234." }

/-- An agent's reply on a review route: no app key, footer present. -/
def agentReviewReply : Said :=
  { place := .reviewComment, id := 13, thread := 512, login := "o", via := .absent, created := 30,
    updated := 30, state := none, body := "Fixed in abc1234." ++ footerText }

/-- An empty `COMMENTED` review wrapper, which the review routes return around inline comments. -/
def emptyReview : Said :=
  { place := .review, id := 16, thread := 512, login := "o", via := .absent, created := 31,
    updated := 31, state := some "COMMENTED", body := "" }

theorem quotedFooterIsStillTyped : ownerQuotesAFooter.speaker = .typed := by decide +kernel

theorem quotedFooterIsWordsForPrState :
    words ownerQuotesAFooter = true ∧ answer answerApps ownerQuotesAFooter = false := by
  decide +kernel

theorem codexWithTheFooterAnswers :
    words codexCatchUp = false ∧ answer answerApps codexCatchUp = true := by decide +kernel

theorem codexWithoutTheFooterIsNeither :
    words codexBare = false ∧ answer answerApps codexBare = false := by decide +kernel

theorem claudeWithoutTheFooterAnswers : answer answerApps claudeBare = true := by decide +kernel

theorem reviewReplyIsUntold : agentReviewReply.speaker = .untold := by decide +kernel

theorem reviewReplyWithFooterAnswersForPrState : answer answerApps agentReviewReply = true := by
  decide +kernel

theorem anEmptyCommentedReviewDoesNotCount : counts emptyReview = false := by decide +kernel

theorem quotedWordsStayUnanswered :
    unansweredIn "o" answerApps [ownerQuotesAFooter, { codexBare with thread := 501, created := 40 }]
      501 = [11] := by decide +kernel

end Fixture

end MitosGate.Watch
